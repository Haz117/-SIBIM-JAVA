# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (ya está excluido en .gitignore).
#
# Ubicación en producción (Windows):  %APPDATA%\SIBIM\.env
# Ubicación en desarrollo:            raíz del proyecto

DB_URL=jdbc:postgresql://localhost:5432/sibim
# En las PCs usa el rol de mínimo privilegio sibim_app (scripts/sql/rol_app_minimo.sql),
# nunca el usuario dueño de la base (postgres): quien abra este archivo tendría
# control total de la base.
DB_USER=sibim_user
DB_PASSWORD=cambia_esta_contrasena

# false en las PCs que usan sibim_app: no intentan migrar el esquema (ese rol no
# tiene permisos de DDL), solo verifican que esté al día. Las migraciones de una
# versión nueva se aplican abriéndola primero en la PC de administración, con el
# usuario dueño y sin esta línea.
# DB_MIGRATE=false

# SSL para conexiones remotas / Supabase — usar "require" en producción,
# "prefer" para desarrollo local (usa SSL si el servidor lo soporta).
DB_SSL_MODE=prefer

# Opcional — carpeta donde se guardan las fotos de los bienes.
# En un despliegue con varias PCs, debe ser una ruta de red (UNC o unidad
# mapeada) accesible con la MISMA ruta desde cada PC, o las fotos subidas
# en una PC no se verán en las demás. Si se omite, cada PC usa su propia
# carpeta local — solo aceptable para desarrollo/una sola PC.
# IMG_DIR=\\servidor\sibim\imagenes

# Supabase Storage — solo clave pública anon. NUNCA uses service_role / sb_secret_… en
# una PC cliente (ni en esta variable ni como SUPABASE_SERVICE_KEY): da control total del
# proyecto a quien abra el archivo. La app ignora claves secretas y lo avisa en el log.
# Requiere políticas RLS/Storage que permitan únicamente las operaciones necesarias.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu_clave_anon_publica

# Opcional — SOLO para desarrollo local sin PostgreSQL instalado. Fuerza el
# "modo demo" (datos ficticios en memoria, se pierden al cerrar la app,
# botones de cuentas de prueba en el login) en vez del "modo offline" real
# que el sistema usa por defecto cuando no logra conectar (ver README).
# NUNCA actives esto en una instalación real del ayuntamiento.
# DEMO_MODE=true

# Opcional — el arranque ya NO ejecuta flyway.repair() automáticamente: repair()
# reescribe descripción/checksum de las migraciones ya aplicadas SIN correr su
# SQL, y así oculta choques de numeración (el historial dice "aplicada" pero los
# cambios nunca llegaron a la base). Si una migración ya aplicada cambió a
# propósito (o hay una migración fallida que limpiar), pon esto en true UNA vez,
# reinicia y vuelve a quitarlo.
# FLYWAY_AUTO_REPAIR=true
