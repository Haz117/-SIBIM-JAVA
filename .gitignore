# ── Credenciales y entorno ────────────────────────────────────────
.env
*.env.local

# ── Build de Maven ────────────────────────────────────────────────
target/
dependency-reduced-pom.xml

# ── IDE ───────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.code-workspace
nbproject/
nb-configuration.xml

# ── Claude Code ───────────────────────────────────────────────────
.claude/

# ── Sistema operativo ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/

# ── Imágenes subidas por el usuario (datos locales) ───────────────
data/

# ── Instalador generado por jpackage ──────────────────────────────
packaging/dist/

# ── Archivos de datos locales del usuario (fotos, resguardos) ──────
# Estos se almacenan en %USERPROFILE%\.sibim\ fuera del repo;
# si alguien los coloca dentro del proyecto, que no se suban.
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.pdf

# Excepción: imágenes que forman parte de la app (íconos, logo municipal
# img/logo-municipio.png que usan los formatos PDF/Excel).
!src/main/resources/img/**

# ── Datos personales: escaneos de resguardos/oficios y los SQL generados del
# inventario real (nombres de resguardantes). Se quedan en la PC, nunca en git.
documentos/
tools/output/

# ── Archivos temporales del editor ────────────────────────────────
*.tmp
*.tmp.*
C*Tempsibim-stdout.txt
test-output.txt
__pycache__/

# ── Inventario físico real del ayuntamiento (miles de .docx/.xlsx, ~4 GB) ──
# Son datos de trabajo, no código: nunca deben llegar a GitHub.
INV.DIG MLA/
