<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sibim.controller.AlertasController"
            fitToWidth="true" styleClass="page-scroll">
<VBox spacing="20">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-danger">
        <StackPane styleClass="page-header-icon page-header-icon-danger">
            <FontIcon iconLiteral="mdi2b-bell-alert" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Alertas de Inventario" styleClass="page-title"/>
            <Label text="Bienes agotados, existencias bajas y garantías por vencer" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="22" prefHeight="22"
                           visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Recalcular alertas (auto-refresca cada 5 min)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ BARRA DE BÚSQUEDA ════════════════════════════════════════ -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar filter-bar-danger">
        <StackPane HBox.hgrow="ALWAYS">
            <TextField fx:id="searchField" promptText="🔍  Buscar bien por nombre o código..."
                       styleClass="search-field" maxWidth="Infinity">
                <tooltip><Tooltip text="Filtrar las alertas por nombre o código del bien"/></tooltip>
            </TextField>
            <Button fx:id="btnClearSearch" text="" styleClass="search-clear-btn"
                    StackPane.alignment="CENTER_RIGHT" visible="false" managed="false" onAction="#onClearSearch">
                <graphic><FontIcon iconLiteral="mdi2c-close"/></graphic>
                <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
            </Button>
        </StackPane>
        <Label fx:id="lblActualizado" text="" styleClass="muted"/>
    </HBox>

    <!-- ══ SIN ALERTAS (condicional) ════════════════════════════════ -->
    <Label fx:id="lblSinAlertas"
           text="Todo en orden — No hay alertas activas en este momento."
           styleClass="no-alerts" visible="false" managed="false" maxWidth="Infinity">
        <graphic><FontIcon iconLiteral="mdi2c-check-circle-outline"/></graphic>
    </Label>

    <!-- ══ BIENES AGOTADOS ═══════════════════════════════════════════ -->
    <VBox fx:id="sectionAgotados" styleClass="alert-section alert-danger" spacing="0">
        <!-- Header gradiente -->
        <HBox styleClass="alert-header-danger" alignment="CENTER_LEFT" spacing="12">
            <FontIcon iconLiteral="mdi2a-alert-octagon-outline" styleClass="alert-section-icon"/>
            <VBox HBox.hgrow="ALWAYS" spacing="1">
                <Label text="Bienes Agotados" styleClass="alert-section-title-inv"/>
                <Label text="Stock = 0 · Requieren reposición inmediata"
                       styleClass="alert-section-subtitle"/>
            </VBox>
            <Label fx:id="helpAgotados" text="?" styleClass="help-badge-inv">
                <tooltip><Tooltip text="Bienes activos con stock actual en 0. Doble clic en una fila para ver el detalle." wrapText="true" maxWidth="250"/></tooltip>
            </Label>
            <Label fx:id="lblAgotadosCount" styleClass="badge-count-inv"/>
        </HBox>

        <VBox spacing="10">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <TableView fx:id="tableAgotados" prefHeight="185" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colAgNombre" text="Nombre"   prefWidth="240" sortable="true"/>
                    <TableColumn fx:id="colAgCodigo" text="Código"   prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colAgArea"   text="Área"     prefWidth="240" sortable="true"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="4">
                        <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="alert-ok-icon"/>
                        <Label text="Sin bienes agotados" styleClass="empty-state-msg"/>
                    </VBox>
                </placeholder>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label text="Selecciona un bien y registra la reposición de stock"
                       styleClass="muted" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnReponerTodos" text="Reponer siguiente" onAction="#onReponerTodosAgotados" styleClass="btn-secondary"
                        contentDisplay="LEFT" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="mdi2d-download-outline" styleClass="btn-icon"/></graphic>
                    <tooltip><Tooltip text="Abre el formulario de entrada para el primer bien agotado pendiente"/></tooltip>
                </Button>
                <Button fx:id="btnReponerAgotado" text="Reponer seleccionado" onAction="#onReponerAgotado" styleClass="btn-primary" disable="true"
                        contentDisplay="LEFT" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="mdi2u-upload-outline" styleClass="btn-icon"/></graphic>
                    <tooltip><Tooltip text="Registrar una entrada de stock para el bien seleccionado"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </VBox>

    <!-- ══ EXISTENCIAS BAJAS ══════════════════════════════════════════ -->
    <VBox fx:id="sectionBajoStock" styleClass="alert-section alert-warning" spacing="0">
        <HBox styleClass="alert-header-warning" alignment="CENTER_LEFT" spacing="12">
            <FontIcon iconLiteral="mdi2b-bell-alert" styleClass="alert-section-icon-white"/>
            <VBox HBox.hgrow="ALWAYS" spacing="1">
                <Label text="Existencias Bajas" styleClass="alert-section-title-inv"/>
                <Label text="Stock actual por debajo del mínimo establecido"
                       styleClass="alert-section-subtitle"/>
            </VBox>
            <Label fx:id="helpBajoStock" text="?" styleClass="help-badge-inv">
                <tooltip><Tooltip text="Bienes activos cuyo stock actual está por debajo del stock mínimo configurado (pero aún no en 0). Doble clic en una fila para ver el detalle." wrapText="true" maxWidth="260"/></tooltip>
            </Label>
            <Label fx:id="lblBajoStockCount" styleClass="badge-count-inv"/>
        </HBox>

        <VBox spacing="10">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <TableView fx:id="tableBajoStock" prefHeight="185" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colBsNombre" text="Nombre"       prefWidth="210" sortable="true"/>
                    <TableColumn fx:id="colBsCodigo" text="Código"       prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colBsStock"  text="Stock Actual" prefWidth="115" sortable="true"/>
                    <TableColumn fx:id="colBsMin"    text="Stock Mínimo" prefWidth="115" sortable="true"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="4">
                        <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="alert-ok-icon"/>
                        <Label text="Sin existencias bajas" styleClass="empty-state-msg"/>
                    </VBox>
                </placeholder>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label text="Selecciona un bien para solicitar reposición"
                       styleClass="muted"/>
                <Button fx:id="btnReponerBajoStock" text="Reponer seleccionado" onAction="#onSolicitarBajoStock" styleClass="btn-warning" disable="true"
                        contentDisplay="LEFT" graphicTextGap="8">
                    <graphic><FontIcon iconLiteral="mdi2u-upload-outline" styleClass="btn-icon"/></graphic>
                    <tooltip><Tooltip text="Registrar una entrada de stock para el bien seleccionado"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </VBox>

    <!-- ══ GARANTÍAS POR VENCER ═══════════════════════════════════════ -->
    <VBox fx:id="sectionGarantias" styleClass="alert-section alert-info" spacing="0">
        <HBox styleClass="alert-header-info" alignment="CENTER_LEFT" spacing="12">
            <FontIcon iconLiteral="mdi2c-clipboard-list-outline" styleClass="alert-section-icon"/>
            <VBox HBox.hgrow="ALWAYS" spacing="1">
                <Label text="Garantías por Vencer" styleClass="alert-section-title-inv"/>
                <Label text="Vencen en los próximos 7 días · Revisa y documenta"
                       styleClass="alert-section-subtitle"/>
            </VBox>
            <Label fx:id="helpGarantias" text="?" styleClass="help-badge-inv">
                <tooltip><Tooltip text="Bienes cuya garantía vence dentro de los próximos 7 días. Doble clic en una fila para ver el detalle." wrapText="true" maxWidth="250"/></tooltip>
            </Label>
            <Label fx:id="lblGarantiasCount" styleClass="badge-count-inv"/>
        </HBox>

        <VBox spacing="10">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <TableView fx:id="tableGarantias" prefHeight="185" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colGaNombre" text="Nombre"          prefWidth="210" sortable="true"/>
                    <TableColumn fx:id="colGaCodigo" text="Código"          prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colGaFecha"  text="Fecha Venc."     prefWidth="135" sortable="true"/>
                    <TableColumn fx:id="colGaDias"   text="Días Restantes"  prefWidth="135" sortable="true"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="4">
                        <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="alert-ok-icon"/>
                        <Label text="Sin garantías próximas a vencer" styleClass="empty-state-msg"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>

</VBox>
</ScrollPane>
