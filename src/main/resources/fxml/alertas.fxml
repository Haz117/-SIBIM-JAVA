<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sibim.controller.AlertasController"
            fitToWidth="true" fitToHeight="true" styleClass="page-scroll">
<VBox fx:id="rootPane" spacing="16">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header, page-header-indigo">
        <StackPane styleClass="page-header-icon, page-header-icon-indigo">
            <FontIcon iconLiteral="mdi2b-bell-alert" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Alertas y pendientes" styleClass="page-title"/>
            <Label text="Garantías por vencer, mantenimientos, comodatos y pendientes patrimoniales" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="22" prefHeight="22"
                           visible="false" managed="false"/>
        <Label fx:id="lblActualizado" text="" styleClass="muted" minWidth="-Infinity"/>
        <MenuButton fx:id="btnExportar" text="Exportar" styleClass="btn-secondary" minWidth="-Infinity"
                    contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-download-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Exportar el reporte de alertas" wrapText="true" maxWidth="240"/></tooltip>
            <items>
                <MenuItem text="PDF" onAction="#onExportarPdf">
                    <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="report-export-icon-pdf"/></graphic>
                </MenuItem>
                <MenuItem text="Excel" onAction="#onExportarExcel">
                    <graphic><FontIcon iconLiteral="mdi2f-file-excel-outline" styleClass="report-export-icon-excel"/></graphic>
                </MenuItem>
                <MenuItem text="CSV" onAction="#onExportarCsv">
                    <graphic><FontIcon iconLiteral="mdi2f-file-delimited-outline" styleClass="report-export-icon-csv"/></graphic>
                </MenuItem>
            </items>
        </MenuButton>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-ghost" minWidth="-Infinity"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Recalcular alertas (auto-refresca cada 5 min)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ PESTAÑAS ═══════════════════════════════════════════════════
         Cada tarjeta resume una categoría y, al elegirla, muestra su
         tabla en el panel de abajo.
         ══════════════════════════════════════════════════════════════ -->
    <GridPane hgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox fx:id="statCardGarantiasSum" styleClass="status-mini-card, status-mini-card-violet, alert-tab"
              GridPane.columnIndex="0" spacing="5">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2c-calendar-alert" styleClass="status-icon-violet"/>
                <Label text="GARANTÍAS" styleClass="status-mini-label"/>
            </HBox>
            <Label fx:id="lblSumGarantias" text="0" styleClass="status-mini-count"/>
            <Label fx:id="lblSumGarantiasDetalle" text="— vencidas · — próximas" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardMantenimientoSum" styleClass="status-mini-card, status-mini-card-amber, alert-tab"
              GridPane.columnIndex="1" spacing="5">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2w-wrench-outline" styleClass="status-icon-amber"/>
                <Label text="MANTENIMIENTO" styleClass="status-mini-label"/>
            </HBox>
            <Label fx:id="lblSumMantenimiento" text="0" styleClass="status-mini-count"/>
            <Label text="revisiones en los próximos 30 días" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardComodatosSum" styleClass="status-mini-card, status-mini-card-red, alert-tab"
              GridPane.columnIndex="2" spacing="5">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2h-handshake-outline" styleClass="status-icon-red"/>
                <Label text="COMODATOS" styleClass="status-mini-label"/>
            </HBox>
            <Label fx:id="lblSumComodatos" text="0" styleClass="status-mini-count"/>
            <Label text="vencidos sin concluir" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardPendientesSum" styleClass="status-mini-card, status-mini-card-green, alert-tab"
              GridPane.columnIndex="3" spacing="5">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2c-clipboard-check-outline" styleClass="status-icon-green"/>
                <Label text="PENDIENTES" styleClass="status-mini-label"/>
            </HBox>
            <Label fx:id="lblSumPendientes" text="0" styleClass="status-mini-count"/>
            <Label fx:id="lblSumPendientesDetalle" text="sin resguardante · sin etiquetar" styleClass="rich-stat-hint"/>
        </VBox>
    </GridPane>

    <!-- ══ PANEL DE LA CATEGORÍA ELEGIDA ════════════════════════════ -->
    <VBox styleClass="alert-panel" spacing="12" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="lblPanelTitulo" styleClass="card-title"/>
                    <Label fx:id="lblPanelConteo" styleClass="dash-section-badge" minWidth="-Infinity"/>
                </HBox>
                <Label fx:id="lblPanelSubtitulo" styleClass="muted"/>
            </VBox>
            <StackPane prefWidth="300" minWidth="200">
                <TextField fx:id="searchField" promptText="Buscar por nombre, código o área..."
                           styleClass="search-field" maxWidth="Infinity">
                    <tooltip><Tooltip text="Filtra todas las categorías por nombre, código o área del bien  (Ctrl+F)"/></tooltip>
                </TextField>
                <Button fx:id="btnClearSearch" text="" styleClass="search-clear-btn"
                        StackPane.alignment="CENTER_RIGHT" visible="false" managed="false" onAction="#onClearSearch"
                        accessibleText="Limpiar búsqueda">
                    <graphic><FontIcon iconLiteral="mdi2c-close"/></graphic>
                    <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
                </Button>
            </StackPane>
            <Button fx:id="btnResetColumns" styleClass="btn-icon-only" contentDisplay="GRAPHIC_ONLY"
                    accessibleText="Restaurar columnas">
                <graphic><FontIcon iconLiteral="mdi2t-table-refresh" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Restaurar las columnas de las tablas a su configuración original"
                                  wrapText="true" maxWidth="270"/></tooltip>
            </Button>
        </HBox>

        <!-- Controles propios de una categoría (Pendientes: por área / por bien). -->
        <HBox fx:id="panelExtras" alignment="CENTER_LEFT" visible="false" managed="false"/>

        <StackPane fx:id="panelTablas" minHeight="280" VBox.vgrow="ALWAYS">
            <TableView fx:id="tableGarantias" styleClass="data-table" tableMenuButtonVisible="true">
                <columns>
                    <TableColumn fx:id="colGaNombre" text="Bien"            prefWidth="260" sortable="true"/>
                    <TableColumn fx:id="colGaCodigo" text="Código"          prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colGaArea"   text="Área"            prefWidth="200" sortable="true"/>
                    <TableColumn fx:id="colGaFecha"  text="Vence"           prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colGaDias"   text="Días restantes"  prefWidth="130" sortable="true"/>
                </columns>
            </TableView>
            <TableView fx:id="tableMantenimiento" styleClass="data-table" tableMenuButtonVisible="true">
                <columns>
                    <TableColumn fx:id="colMantNombre"  text="Bien"              prefWidth="220" sortable="true"/>
                    <TableColumn fx:id="colMantCodigo"  text="Código"            prefWidth="110" sortable="true"/>
                    <TableColumn fx:id="colMantArea"    text="Área"              prefWidth="170" sortable="true"/>
                    <TableColumn fx:id="colMantFecha"   text="Próxima revisión"  prefWidth="140" sortable="true"/>
                    <TableColumn fx:id="colMantNotas"   text="Notas"             prefWidth="200" sortable="true"/>
                </columns>
            </TableView>
        </StackPane>
    </VBox>

</VBox>
</ScrollPane>
