<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- 19-nov-2026: at 1366×689 four cards and a filter bar in two rows left 6 rows for the
     table, and the Detalle column showed «Datos del bien actualizados · número …» but never
     what changed. Now the acciones are chips that filter (with their counts), the filters fit
     one row, and the columns say when, which bien, its área, what changed and who. -->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.AuditoriaController"
      spacing="0" styleClass="page-root">

    <!-- PAGE HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header, page-header-indigo">
        <VBox.margin><Insets top="20" right="22" left="34"/></VBox.margin>
        <StackPane styleClass="page-header-icon, page-header-icon-indigo">
            <FontIcon iconLiteral="mdi2s-shield-lock-outline" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Auditoría del Sistema" styleClass="page-title"/>
            <Label text="Quién hizo qué y cuándo: cada cambio a los bienes, los resguardos y las cuentas" styleClass="page-subtitle"/>
        </VBox>
        <MenuButton fx:id="btnExportar" text="Exportar" styleClass="btn-secondary"
                    contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-download-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Exportar los registros con los filtros actuales" wrapText="true" maxWidth="240"/></tooltip>
            <items>
                <MenuItem text="PDF" onAction="#onExportarPdf">
                    <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="report-export-icon-pdf"/></graphic>
                </MenuItem>
                <MenuItem text="Excel" onAction="#onExportarExcel">
                    <graphic><FontIcon iconLiteral="mdi2f-file-excel-outline" styleClass="report-export-icon-excel"/></graphic>
                </MenuItem>
                <MenuItem text="CSV" onAction="#onExportarCsv">
                    <graphic><FontIcon iconLiteral="mdi2f-file-delimited-outline" styleClass="report-export-icon-csv"/></graphic>
                </MenuItem>
            </items>
        </MenuButton>
        <ProgressIndicator fx:id="loadSpinner" prefWidth="20" prefHeight="20" visible="false" managed="false"/>
        <Button fx:id="btnRefresh" onAction="#onRefresh" styleClass="btn-icon-only" contentDisplay="GRAPHIC_ONLY"
                accessibleText="Actualizar">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Actualizar  (F5)"/></tooltip>
        </Button>
        <Button fx:id="btnResetColumns" styleClass="btn-icon-only" contentDisplay="GRAPHIC_ONLY"
                accessibleText="Restaurar columnas">
            <graphic><FontIcon iconLiteral="mdi2t-table-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Restaurar columnas de la tabla a su configuración original (orden, ancho y visibilidad)"
                              wrapText="true" maxWidth="260"/></tooltip>
        </Button>
    </HBox>

    <!-- FILTER BAR: the search, what and who, the period; the acciones below, as chips. -->
    <VBox fx:id="filterBar" spacing="8" styleClass="filter-bar">
        <VBox.margin><Insets top="12" right="22" left="34"/></VBox.margin>
        <padding><Insets top="10" right="14" bottom="10" left="16"/></padding>
        <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <StackPane prefWidth="300">
                <TextField fx:id="searchField" promptText="Buscar número, nombre, folio…"
                           styleClass="search-field" maxWidth="Infinity"
                           onKeyReleased="#onSearch" accessibleText="Buscar en la bitácora"/>
            </StackPane>
            <ComboBox fx:id="entidadFilter" prefWidth="180" onAction="#onFilter" accessibleText="Sobre qué"/>
            <ComboBox fx:id="usuarioFilter" prefWidth="200" onAction="#onFilter" accessibleText="Quién"/>
            <ComboBox fx:id="periodoBox" prefWidth="170" accessibleText="Periodo"/>
            <HBox fx:id="fechasBox" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
                <DatePicker fx:id="desdeField" prefWidth="140" onAction="#onFiltroFecha" promptText="Desde"
                            accessibleText="Desde"/>
                <Label text="–" styleClass="muted"/>
                <DatePicker fx:id="hastaField" prefWidth="140" onAction="#onFiltroFecha" promptText="Hasta"
                            accessibleText="Hasta"/>
            </HBox>
            <Button fx:id="btnSoloBien" onAction="#onQuitarSoloBien" styleClass="btn-preset-active"
                    visible="false" managed="false" contentDisplay="RIGHT" graphicTextGap="6">
                <graphic><FontIcon iconLiteral="mdi2c-close" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Quitar: volver a ver todos los registros"/></tooltip>
            </Button>
            <Button fx:id="btnLimpiar" text="Limpiar filtros" onAction="#onLimpiar" styleClass="btn-ghost"
                    visible="false" managed="false">
                <graphic><FontIcon iconLiteral="mdi2f-filter-remove-outline" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Quitar la búsqueda y todos los filtros"/></tooltip>
            </Button>
        </FlowPane>
        <!-- Each acción with how many there are with the other filters; a click filters by it. -->
        <FlowPane fx:id="chipsAccion" hgap="6" vgap="6" alignment="CENTER_LEFT" accessibleText="Acciones"/>
    </VBox>

    <!-- TABLE -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="8" right="22" bottom="0" left="34"/></padding>
        <Region styleClass="dash-section-bar"/>
        <Label text="REGISTROS" styleClass="dash-section-label"/>
        <Label text="Doble clic o Enter: el detalle, con cada cambio" styleClass="muted-sm"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" styleClass="muted-sm"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table" tableMenuButtonVisible="true">
        <VBox.margin><Insets top="6" right="22" left="34"/></VBox.margin>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colCuando" text="Cuándo"      prefWidth="100" minWidth="96"/>
            <TableColumn fx:id="colSobre"  text="Sobre qué"   prefWidth="215" minWidth="150"/>
            <TableColumn fx:id="colArea"   text="Área"        prefWidth="125" minWidth="90"/>
            <TableColumn fx:id="colAccion" text="Acción"      prefWidth="142" minWidth="140"/>
            <TableColumn fx:id="colQuien"  text="Quién"       prefWidth="185" minWidth="90"/>
            <TableColumn fx:id="colCambio" text="Qué cambió"  prefWidth="330" minWidth="180"/>
        </columns>
    </TableView>

    <!-- PAGINATION BAR -->
    <HBox fx:id="paginationBar" alignment="CENTER" spacing="8" styleClass="pagination-bar">
        <padding><Insets top="10" right="22" bottom="10" left="34"/></padding>
        <Button fx:id="btnPrimera"  onAction="#onPrimera"  styleClass="btn-page" contentDisplay="GRAPHIC_ONLY" accessibleText="Primera página">
            <graphic><FontIcon iconLiteral="mdi2p-page-first" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Primera página  (Ctrl+Inicio)"/></tooltip>
        </Button>
        <Button fx:id="btnAnterior" onAction="#onAnterior" styleClass="btn-page" contentDisplay="GRAPHIC_ONLY" accessibleText="Página anterior">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-left" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Página anterior  (Ctrl+←)"/></tooltip>
        </Button>
        <Label fx:id="lblPagina" styleClass="pagination-label"/>
        <Button fx:id="btnSiguiente" onAction="#onSiguiente" styleClass="btn-page" contentDisplay="GRAPHIC_ONLY" accessibleText="Página siguiente">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-right" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Página siguiente  (Ctrl+→)"/></tooltip>
        </Button>
        <Button fx:id="btnUltima"   onAction="#onUltima"   styleClass="btn-page" contentDisplay="GRAPHIC_ONLY" accessibleText="Última página">
            <graphic><FontIcon iconLiteral="mdi2p-page-last" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Última página  (Ctrl+Fin)"/></tooltip>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="pageSizeBox" prefWidth="90" accessibleText="Registros por página"/>
    </HBox>
</VBox>
