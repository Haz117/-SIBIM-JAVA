<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.CategoriasController"
      fx:id="rootPane" spacing="12">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-teal">
        <!-- Icon badge -->
        <StackPane styleClass="page-header-icon page-header-icon-teal">
            <FontIcon iconLiteral="mdi2t-tag-outline" styleClass="page-icon-emoji"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Categorías de Bienes" styleClass="page-title"/>
            <Label text="Clasificaciones para organizar el inventario patrimonial" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="22" prefHeight="22"
                           visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Actualizar lista de categorías (F5)"/></tooltip>
        </Button>
        <Button fx:id="btnNueva" text="＋ Nueva Categoría" onAction="#onNuevaCategoria" styleClass="btn-primary">
            <tooltip><Tooltip text="Crear una nueva categoría de bienes  (Ctrl+N)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ SECCIÓN RESUMEN ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar-teal"/>
        <Label text="RESUMEN DE CATEGORÍAS" styleClass="dash-section-label"/>
    </HBox>

    <!-- ══ STAT CARDS ═══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <!-- Total de Categorías — indigo -->
        <VBox fx:id="statCardTotal" styleClass="rich-stat-card, rich-stat-indigo"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="TOTAL DE CATEGORÍAS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpStatTotal" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Cantidad de categorías registradas en el sistema, tengan o no bienes asignados." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatTotal" text="—" styleClass="rich-stat-value"/>
            <Label text="clasificaciones activas" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Bienes Clasificados — teal -->
        <VBox fx:id="statCardClasificados" styleClass="rich-stat-card, rich-stat-teal"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2p-package-variant" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="BIENES CLASIFICADOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpStatClasificados" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Total de bienes activos que ya tienen una categoría asignada, sumando todas las categorías." wrapText="true" maxWidth="250"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatClasificados" text="—" styleClass="rich-stat-value"/>
            <Label text="bienes con categoría" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Categoría con Más Bienes — amber -->
        <VBox fx:id="statCardTop" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <FontIcon iconLiteral="mdi2s-star-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="CATEGORÍA CON MÁS BIENES" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpStatTop" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="La categoría con la mayor cantidad de bienes asignados, sin importar su valor." wrapText="true" maxWidth="250"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatTop" text="—" styleClass="rich-stat-value, rich-stat-value-sm"/>
            <Label text="mayor concentración de bienes" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>

    <!-- ══ SECCIÓN TABLA ════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar-teal"/>
        <Label text="LISTADO DE CATEGORÍAS" styleClass="dash-section-label"/>
        <Label fx:id="helpCategorias" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Las categorías clasifican los bienes del inventario (Mobiliario, Vehículos, etc.). La columna Bienes cuenta cuántos bienes activos tiene cada una; solo se puede eliminar una categoría si no tiene bienes asignados." wrapText="true" maxWidth="280"/></tooltip>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="0 categorías" styleClass="muted"/>
    </HBox>

    <!-- ══ FILTER BAR ════════════════════════════════════════════════ -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar, filter-bar-teal">
        <StackPane prefWidth="280">
            <TextField fx:id="searchField"
                       promptText="🔍  Buscar por nombre o descripción..."
                       maxWidth="Infinity" styleClass="search-field"/>
            <Button fx:id="btnClearSearch" text="" styleClass="search-clear-btn"
                    StackPane.alignment="CENTER_RIGHT" visible="false" managed="false">
                <graphic><FontIcon iconLiteral="mdi2c-close"/></graphic>
                <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
            </Button>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ══ DATA TABLE ════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colColor"       text="Color"       prefWidth="80"  sortable="false"/>
            <TableColumn fx:id="colIcono"       text="Ícono"       prefWidth="70"  sortable="false"/>
            <TableColumn fx:id="colNombre"      text="Nombre"      prefWidth="200" sortable="true"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="310" sortable="true"/>
            <TableColumn fx:id="colProductos"   text="Bienes"      prefWidth="80"  sortable="true"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <FontIcon iconLiteral="mdi2t-tag-outline" styleClass="empty-icon-lg"/>
                <Label text="No hay categorías registradas" styleClass="empty-state-msg"/>
                <Label text="Usa ＋ Nueva Categoría para clasificar tus bienes patrimoniales" styleClass="empty-state-hint"/>
            </VBox>
        </placeholder>
    </TableView>

    <!-- ══ BOTTOM ACTION BAR ══════════════════════════════════════════ -->
    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="bottom-action-bar">
        <Label text="Selecciona una categoría para editar o eliminar"
               styleClass="muted-sm" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEditCat" text="Editar" onAction="#onEdit" styleClass="btn-secondary"
                disable="true" contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2p-pencil" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Editar la categoría seleccionada"/></tooltip>
        </Button>
        <Button fx:id="btnDeleteCat" text="Eliminar" onAction="#onDelete" styleClass="btn-danger" disable="true"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-delete-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Eliminar categoría (solo si no tiene bienes asignados)"/></tooltip>
        </Button>
    </HBox>
</VBox>
