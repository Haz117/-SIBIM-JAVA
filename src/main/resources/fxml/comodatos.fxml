<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.ComodatosController"
      fx:id="rootPane" spacing="12">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-purple">
        <StackPane styleClass="page-header-icon page-header-icon-purple">
            <FontIcon iconLiteral="mdi2c-clipboard-list-outline" styleClass="page-icon-emoji"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Comodatos" styleClass="page-title"/>
            <Label text="Acuerdos formales de préstamo a entidades externas — el bien permanece propiedad municipal" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="22" prefHeight="22" visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-ghost"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnToggleResumen" styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-up" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Muestra u oculta las tarjetas de resumen para dar más espacio a la tabla" wrapText="true" maxWidth="240"/></tooltip>
        </Button>
        <Label fx:id="helpResumen" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Oculta las tarjetas de resumen para darle más espacio a la tabla — se puede volver a mostrar con el mismo botón." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
        <Button fx:id="btnNuevo" text="＋ Nuevo Comodato" onAction="#onNuevoComodato" styleClass="btn-primary"/>
    </HBox>

    <VBox fx:id="resumenBox" spacing="12">
    <!-- ══ STAT CARDS ══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <VBox fx:id="statCardVigentes" styleClass="rich-stat-card, rich-stat-teal"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2c-clipboard-list-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="VIGENTES" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatVigentes" text="—" styleClass="rich-stat-value"/>
            <Label text="comodatos activos" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardVencidos" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <FontIcon iconLiteral="mdi2a-alert-circle-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="VENCIDOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatVencidos" text="—" styleClass="rich-stat-value"/>
            <Label text="fuera de plazo" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardConcluidos" styleClass="rich-stat-card, rich-stat-indigo"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2c-check-all" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="CONCLUIDOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatConcluidos" text="—" styleClass="rich-stat-value"/>
            <Label text="comodatos cerrados" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardTotal" styleClass="rich-stat-card, rich-stat-slate"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-slate">
                    <FontIcon iconLiteral="mdi2f-format-list-bulleted" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="TOTAL" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatTotal" text="—" styleClass="rich-stat-value"/>
            <Label text="comodatos registrados" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>
    </VBox>

    <!-- ══ TOOLBAR ════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Buscar por bien, entidad, contacto o número…"
                   styleClass="search-field" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="estadoFilter" prefWidth="140"/>
        <Button fx:id="btnExportarPdf" text="PDF" onAction="#onExportarPdf"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="btn-icon"/></graphic>
        </Button>
    </HBox>

    <!-- ══ TABLE ══════════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colNumero"    text="Folio"            prefWidth="120"/>
            <TableColumn fx:id="colBien"      text="Bien"             prefWidth="200"/>
            <TableColumn fx:id="colEntidad"   text="Entidad Receptora" prefWidth="200"/>
            <TableColumn fx:id="colContacto"  text="Contacto"         prefWidth="160"/>
            <TableColumn fx:id="colFechaInicio" text="Inicio"         prefWidth="90"/>
            <TableColumn fx:id="colFechaFin"  text="Fin"              prefWidth="90"/>
            <TableColumn fx:id="colEstado"    text="Estado"           prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="No hay comodatos registrados. Las filas en amarillo indican comodatos vencidos."
                   styleClass="table-placeholder"/>
        </placeholder>
    </TableView>
</VBox>
