<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sibim.controller.DashboardController"
            fitToWidth="true" styleClass="page-scroll">
<VBox spacing="18">
    <padding><Insets top="22" right="24" bottom="24" left="34"/></padding>

    <!-- ══════════════════════════════════════════════════════════
         WELCOME BANNER
         ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="dashBanner" styleClass="dashboard-banner" spacing="0">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

        <!-- Greeting row -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblBienvenida" styleClass="banner-greeting"/>
                <Label fx:id="lblUsuario"    styleClass="banner-name"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2o-office-building-outline" styleClass="banner-brand-icon"/>
                    <Label fx:id="lblOrgBanner" text="H. Ayuntamiento de Ixmiquilpan  ·  Bienes Municipales"
                           styleClass="banner-org"/>
                </HBox>
            </VBox>
            <!-- Date widget -->
            <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="banner-date-widget">
                <Label fx:id="lblFechaDia"  styleClass="banner-date-day"/>
                <Label fx:id="lblFechaMes"  styleClass="banner-date-month"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         ALERT BANNER (condicional)
         ══════════════════════════════════════════════════════════ -->
    <HBox fx:id="alertBanner" styleClass="alert-banner" spacing="10" alignment="CENTER_LEFT"
          visible="false" managed="false" onMouseClicked="#onVerAlertas">
        <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
        <FontIcon iconLiteral="mdi2b-bell-ring" styleClass="alert-banner-icon"/>
        <Label fx:id="lblAlertBannerText" text="Hay bienes que requieren atención."
               wrapText="true" HBox.hgrow="ALWAYS"/>
        <Label text="Ver alertas →" styleClass="alert-banner-cta"/>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: ACCIONES RÁPIDAS
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ACCIONES RÁPIDAS" styleClass="dash-section-label"/>
    </HBox>
    <HBox fx:id="quickActionsRow" spacing="12">
        <VBox fx:id="cardNuevoBien" styleClass="quick-action-card" onMouseClicked="#onAccionNuevoBien"
              HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2p-plus-circle-outline" styleClass="qa-card-icon-indigo"/>
                <VBox spacing="2">
                    <Label text="Nuevo Bien" styleClass="qa-card-title"/>
                    <Label text="Registrar un activo al inventario" styleClass="qa-card-hint"/>
                </VBox>
            </HBox>
        </VBox>
        <VBox fx:id="cardNuevaEntrada" styleClass="quick-action-card" onMouseClicked="#onAccionNuevaEntrada"
              HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2a-arrow-up-bold-circle-outline" styleClass="qa-card-icon-green"/>
                <VBox spacing="2">
                    <Label text="Registrar Entrada" styleClass="qa-card-title"/>
                    <Label text="Nueva entrada de stock" styleClass="qa-card-hint"/>
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="quick-action-card" onMouseClicked="#onVerAlertas"
              HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2b-bell-alert-outline" styleClass="qa-card-icon-amber"/>
                <VBox spacing="2">
                    <Label text="Ver Alertas" styleClass="qa-card-title"/>
                    <Label text="Bienes agotados y bajo stock" styleClass="qa-card-hint"/>
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="quick-action-card" onMouseClicked="#onVerReportes"
              HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2f-file-chart-outline" styleClass="qa-card-icon-blue"/>
                <VBox spacing="2">
                    <Label text="Generar Reporte" styleClass="qa-card-title"/>
                    <Label text="Exportar inventario y más" styleClass="qa-card-hint"/>
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="quick-action-card" onMouseClicked="#onBusquedaGlobal"
              HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="mdi2m-magnify" styleClass="qa-card-icon-violet"/>
                <VBox spacing="2">
                    <Label text="Buscar Bien" styleClass="qa-card-title"/>
                    <Label text="Búsqueda global  (Ctrl+K)" styleClass="qa-card-hint"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: RESUMEN DEL INVENTARIO
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="RESUMEN DEL INVENTARIO" styleClass="dash-section-label"/>
        <Label fx:id="helpStats" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Cifras clave del inventario, actualizadas cada vez que entras al dashboard. Haz clic en una tarjeta para ver el detalle." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStatsActualizacion" text="" styleClass="muted"/>
    </HBox>

    <!-- Stats grid — 1×4: solo cifras que no se repiten en ningún otro
         lado del dashboard (bajo-stock/agotados viven únicamente en el
         health bar de abajo, para no mostrar el mismo número dos veces) -->
    <GridPane fx:id="statsGrid" hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
        </columnConstraints>

        <!-- Total de Bienes — Indigo -->
        <VBox styleClass="rich-stat-card, rich-stat-card-clickable" spacing="14"
              onMouseClicked="#onVerProductos"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2p-package-variant" styleClass="rich-stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpTotalBienes" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Total de bienes activos registrados en el inventario, sin importar su estado de stock." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="TOTAL DE BIENES" styleClass="rich-stat-label"/>
                <Label fx:id="lblTotalBienes" text="—" styleClass="rich-stat-value"/>
                <Label text="Ver inventario →" styleClass="rich-stat-hint"/>
            </VBox>
        </VBox>

        <!-- Valor Patrimonial — Teal -->
        <VBox styleClass="rich-stat-card, rich-stat-card-clickable" spacing="14"
              onMouseClicked="#onVerReportes"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2c-currency-usd" styleClass="rich-stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpValorTotal" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Suma del valor de adquisición de todos los bienes activos del inventario." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="VALOR PATRIMONIAL" styleClass="rich-stat-label"/>
                <Label fx:id="lblValorTotal" text="—" styleClass="rich-stat-value, rich-stat-value-sm"/>
                <Label text="Ver reportes →" styleClass="rich-stat-hint"/>
            </VBox>
        </VBox>

        <!-- Movimientos Hoy — Violet -->
        <VBox styleClass="rich-stat-card, rich-stat-card-clickable" spacing="14"
              onMouseClicked="#onVerMovimientos"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-purple">
                    <FontIcon iconLiteral="mdi2s-sync" styleClass="rich-stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpMovimientosHoy" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Entradas, salidas, ajustes y transferencias registrados hoy." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="MOVIMIENTOS HOY" styleClass="rich-stat-label"/>
                <Label fx:id="lblMovimientosHoy" text="—" styleClass="rich-stat-value"/>
                <Label text="Ver historial →" styleClass="rich-stat-hint"/>
            </VBox>
        </VBox>

        <!-- Categorías — Indigo oscuro -->
        <VBox styleClass="rich-stat-card, rich-stat-card-clickable" spacing="14"
              onMouseClicked="#onVerCategorias"
              GridPane.columnIndex="3" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-dark-indigo">
                    <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpCategorias" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Categorías con al menos un bien activo asignado." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="CATEGORÍAS ACTIVAS" styleClass="rich-stat-label"/>
                <Label fx:id="lblCategorias" text="—" styleClass="rich-stat-value"/>
                <Label text="Ver categorías →" styleClass="rich-stat-hint"/>
            </VBox>
        </VBox>
    </GridPane>

    <!-- ══════════════════════════════════════════════════════════
         ESTADO DEL INVENTARIO (4 mini-cards con barra de progreso)
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ESTADO DEL INVENTARIO" styleClass="dash-section-label"/>
        <Label fx:id="helpHealth" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Distribución de todos los bienes activos por estado de stock. Haz clic en Bajo Stock o Agotados para ver cuáles son." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
    </HBox>
    <HBox fx:id="statusCardsRow" spacing="14" visible="false" managed="false"/>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: ANÁLISIS DE INVENTARIO
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ANÁLISIS DE INVENTARIO" styleClass="dash-section-label"/>
        <Label fx:id="helpAnalisis" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Movimientos Semanales: entradas vs. salidas por día. Valor por Categoría: cómo se reparte el valor patrimonial entre categorías." wrapText="true" maxWidth="270"/></tooltip>
        </Label>
        <Label text="Últimos 7 días" styleClass="dash-section-badge"/>
    </HBox>

    <!-- Charts row -->
    <HBox fx:id="chartsRow" spacing="14">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="mdi2s-swap-vertical" styleClass="card-icon-indigo"/>
                <Label text="Movimientos Semanales" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            </HBox>
            <LineChart fx:id="chartMovimientos" prefHeight="220" animated="false">
                <xAxis><CategoryAxis label="Día"/></xAxis>
                <yAxis><NumberAxis label="Unidades"/></yAxis>
            </LineChart>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="300">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="card-icon"/>
                <Label text="Valor por Categoría" styleClass="card-title"/>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS">
                <PieChart fx:id="chartValorCategoria" prefHeight="220"
                          labelsVisible="true" animated="false"/>
                <VBox fx:id="pieEmptyState" alignment="CENTER" spacing="6"
                      visible="false" managed="false" styleClass="pie-empty-state">
                    <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="pie-empty-icon"/>
                    <Label text="Sin datos de categorías" styleClass="empty-state-msg"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: DISTRIBUCIÓN POR ÁREA
         ══════════════════════════════════════════════════════════ -->
    <HBox fx:id="areasSectionHdr" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
        <Region styleClass="dash-section-bar"/>
        <Label text="DISTRIBUCIÓN POR ÁREA" styleClass="dash-section-label"/>
        <Label text="Top 5 áreas · bienes activos" styleClass="dash-section-badge"/>
    </HBox>
    <VBox fx:id="areasCard" styleClass="card" spacing="14" visible="false" managed="false">
        <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
        <VBox fx:id="areasBarBox" spacing="12"/>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: TENDENCIA MENSUAL
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="TENDENCIA MENSUAL" styleClass="dash-section-label"/>
        <Label text="Últimos 6 meses" styleClass="dash-section-badge"/>
    </HBox>

    <VBox fx:id="trendCard" styleClass="card" spacing="10">
        <padding><Insets top="18" right="18" bottom="14" left="18"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <FontIcon iconLiteral="mdi2t-trending-up" styleClass="card-icon-indigo"/>
            <Label text="Entradas vs. Salidas" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTrendEmpty" text="Sin datos suficientes para mostrar tendencia"
                   styleClass="muted" visible="false" managed="false"/>
        </HBox>
        <AreaChart fx:id="chartTendencia" prefHeight="210" animated="false">
            <xAxis><CategoryAxis/></xAxis>
            <yAxis><NumberAxis minorTickCount="1"/></yAxis>
        </AreaChart>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: ACTIVIDAD RECIENTE
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ACTIVIDAD RECIENTE" styleClass="dash-section-label"/>
        <Label fx:id="lblCountReciente" text="" styleClass="dash-activity-badge"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ver todos →" onAction="#onVerMovimientos"
                styleClass="btn-secondary btn-sm"/>
    </HBox>

    <!-- Recent activity table inside a card -->
    <VBox fx:id="activityCard" styleClass="card" spacing="0">
        <TableView fx:id="tablaReciente" prefHeight="230" styleClass="data-table recent-table">
            <placeholder>
                <VBox alignment="CENTER" spacing="8">
                    <FontIcon iconLiteral="mdi2s-swap-vertical" styleClass="empty-icon-lg"/>
                    <Label text="Sin movimientos recientes" styleClass="empty-state-msg"/>
                    <Label text="Los movimientos registrados aparecerán aquí" styleClass="empty-state-hint"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
</ScrollPane>
