<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sibim.controller.DashboardController"
            fitToWidth="true" styleClass="page-scroll">
<VBox spacing="18">
    <padding><Insets top="22" right="24" bottom="24" left="34"/></padding>

    <!-- ══════════════════════════════════════════════════════════
         WELCOME BANNER
         ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="dashBanner" styleClass="dashboard-banner" spacing="0">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

        <!-- Greeting row -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblBienvenida" styleClass="banner-greeting"/>
                <Label fx:id="lblUsuario"    styleClass="banner-name"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2o-office-building-outline" styleClass="banner-brand-icon"/>
                    <Label text="H. Ayuntamiento de Ixmiquilpan  ·  Bienes Municipales"
                           styleClass="banner-org"/>
                </HBox>
            </VBox>
            <!-- Date widget -->
            <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="banner-date-widget">
                <Label fx:id="lblFechaDia"  styleClass="banner-date-day"/>
                <Label fx:id="lblFechaMes"  styleClass="banner-date-month"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         ALERT BANNER (condicional)
         ══════════════════════════════════════════════════════════ -->
    <HBox fx:id="alertBanner" styleClass="alert-banner" spacing="10" alignment="CENTER_LEFT"
          visible="false" managed="false" onMouseClicked="#onVerAlertas">
        <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
        <FontIcon iconLiteral="mdi2b-bell-ring" styleClass="alert-banner-icon"/>
        <Label fx:id="lblAlertBannerText" text="Hay bienes que requieren atención."
               wrapText="true" HBox.hgrow="ALWAYS"/>
        <Label text="Ver alertas →" styleClass="alert-banner-cta"/>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: RESUMEN DEL INVENTARIO
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="RESUMEN DEL INVENTARIO" styleClass="dash-section-label"/>
        <Label fx:id="helpStats" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Cifras clave del inventario, actualizadas cada vez que entras al dashboard. Haz clic en una tarjeta para ver el detalle." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStatsActualizacion" text="" styleClass="muted"/>
    </HBox>

    <!-- Stats grid — 1×4: solo cifras que no se repiten en ningún otro
         lado del dashboard (bajo-stock/agotados viven únicamente en el
         health bar de abajo, para no mostrar el mismo número dos veces) -->
    <GridPane fx:id="statsGrid" hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
        </columnConstraints>

        <!-- Total de Bienes — Indigo -->
        <VBox styleClass="stat-card, stat-card-clickable" spacing="14"
              onMouseClicked="#onVerProductos"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="stat-icon-badge, stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2p-package-variant" styleClass="stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpTotalBienes" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Total de bienes activos registrados en el inventario, sin importar su estado de stock." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="TOTAL DE BIENES" styleClass="stat-label"/>
                <Label fx:id="lblTotalBienes" text="—" styleClass="stat-value"/>
                <Label text="Ver inventario →" styleClass="stat-hint"/>
            </VBox>
        </VBox>

        <!-- Valor Patrimonial — Teal -->
        <VBox styleClass="stat-card, stat-card-clickable" spacing="14"
              onMouseClicked="#onVerReportes"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="stat-icon-badge, stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2c-currency-usd" styleClass="stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpValorTotal" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Suma del valor de adquisición de todos los bienes activos del inventario." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="VALOR PATRIMONIAL" styleClass="stat-label"/>
                <Label fx:id="lblValorTotal" text="—" styleClass="stat-value-currency"/>
                <Label text="Ver reportes →" styleClass="stat-hint"/>
            </VBox>
        </VBox>

        <!-- Movimientos Hoy — Violet -->
        <VBox styleClass="stat-card, stat-card-clickable" spacing="14"
              onMouseClicked="#onVerMovimientos"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="stat-icon-badge, stat-icon-badge-violet">
                    <FontIcon iconLiteral="mdi2s-sync" styleClass="stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpMovimientosHoy" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Entradas, salidas, ajustes y transferencias registrados hoy." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="MOVIMIENTOS HOY" styleClass="stat-label"/>
                <Label fx:id="lblMovimientosHoy" text="—" styleClass="stat-value"/>
                <Label text="Ver historial →" styleClass="stat-hint"/>
            </VBox>
        </VBox>

        <!-- Categorías — Indigo oscuro -->
        <VBox styleClass="stat-card, stat-card-clickable" spacing="14"
              onMouseClicked="#onVerCategorias"
              GridPane.columnIndex="3" GridPane.rowIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="20"/></padding>
            <HBox alignment="CENTER" spacing="8">
                <StackPane styleClass="stat-icon-badge, stat-icon-badge-dark-indigo">
                    <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="stat-icon"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpCategorias" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Categorías con al menos un bien activo asignado." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <VBox spacing="5">
                <Label text="CATEGORÍAS ACTIVAS" styleClass="stat-label"/>
                <Label fx:id="lblCategorias" text="—" styleClass="stat-value"/>
                <Label text="Ver categorías →" styleClass="stat-hint"/>
            </VBox>
        </VBox>
    </GridPane>

    <!-- ══════════════════════════════════════════════════════════
         ESTADO DEL INVENTARIO (health bar) — única fuente para las
         cifras de bajo stock / agotados / vencidos: haz clic en una
         leyenda para ver el detalle de esos bienes.
         ══════════════════════════════════════════════════════════ -->
    <VBox fx:id="healthSection" styleClass="dash-health-card" spacing="10"
          visible="false" managed="false">
        <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Estado del Inventario" styleClass="dash-health-title"/>
            <Label fx:id="helpHealth" text="?" styleClass="help-badge">
                <tooltip><Tooltip text="Distribución de todos los bienes activos por estado de stock. Haz clic en Bajo Stock o Agotados para ver cuáles son." wrapText="true" maxWidth="260"/></tooltip>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblHealthDetail" text="" styleClass="muted"/>
        </HBox>
        <!-- Segmented bar -->
        <HBox fx:id="healthBar" prefHeight="10" spacing="2" styleClass="dash-health-bar"/>
        <HBox spacing="20">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" styleClass="dot-green"/>
                <Label fx:id="lblHealthActivos" text="Activos — 0" styleClass="dash-health-legend"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT" styleClass="dash-health-legend-clickable"
                  onMouseClicked="#onVerBajoStock">
                <Label text="●" styleClass="dot-amber"/>
                <Label fx:id="lblHealthBajo" text="Bajo Stock — 0" styleClass="dash-health-legend"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT" styleClass="dash-health-legend-clickable"
                  onMouseClicked="#onVerAgotados">
                <Label text="●" styleClass="dot-red"/>
                <Label fx:id="lblHealthAgotado" text="Agotados — 0" styleClass="dash-health-legend"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="●" styleClass="dot-violet"/>
                <Label fx:id="lblHealthVencido" text="Vencidos — 0" styleClass="dash-health-legend"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: ANÁLISIS DE INVENTARIO
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ANÁLISIS DE INVENTARIO" styleClass="dash-section-label"/>
        <Label fx:id="helpAnalisis" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Movimientos Semanales: entradas vs. salidas por día. Valor por Categoría: cómo se reparte el valor patrimonial entre categorías." wrapText="true" maxWidth="270"/></tooltip>
        </Label>
        <Label text="Últimos 7 días" styleClass="dash-section-badge"/>
    </HBox>

    <!-- Charts row -->
    <HBox fx:id="chartsRow" spacing="14">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="mdi2s-swap-vertical" styleClass="card-icon-indigo"/>
                <Label text="Movimientos Semanales" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            </HBox>
            <LineChart fx:id="chartMovimientos" prefHeight="220" animated="false">
                <xAxis><CategoryAxis label="Día"/></xAxis>
                <yAxis><NumberAxis label="Unidades"/></yAxis>
            </LineChart>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="300">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="card-icon"/>
                <Label text="Valor por Categoría" styleClass="card-title"/>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS">
                <PieChart fx:id="chartValorCategoria" prefHeight="220"
                          labelsVisible="true" animated="false"/>
                <VBox fx:id="pieEmptyState" alignment="CENTER" spacing="6"
                      visible="false" managed="false" styleClass="pie-empty-state">
                    <FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="pie-empty-icon"/>
                    <Label text="Sin datos de categorías" styleClass="empty-state-msg"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

    <!-- ══════════════════════════════════════════════════════════
         SECCIÓN: ACTIVIDAD RECIENTE
         ══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="ACTIVIDAD RECIENTE" styleClass="dash-section-label"/>
        <Label fx:id="lblCountReciente" text="" styleClass="dash-activity-badge"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ver todos →" onAction="#onVerMovimientos"
                styleClass="btn-secondary btn-sm"/>
    </HBox>

    <!-- Recent activity table inside a card -->
    <VBox fx:id="activityCard" styleClass="card" spacing="0">
        <TableView fx:id="tablaReciente" prefHeight="230" styleClass="data-table recent-table">
            <placeholder>
                <VBox alignment="CENTER" spacing="8">
                    <FontIcon iconLiteral="mdi2s-swap-vertical" styleClass="empty-icon-lg"/>
                    <Label text="Sin movimientos recientes" styleClass="empty-state-msg"/>
                    <Label text="Los movimientos registrados aparecerán aquí" styleClass="empty-state-hint"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
</ScrollPane>
