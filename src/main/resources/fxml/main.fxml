<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.MainController"
      prefWidth="1200" prefHeight="760">

    <!-- ── Offline / demo mode banner — appears at the top of the window
         when the app is not connected to the live database. Hidden (and
         not managed) when online so it doesn't eat vertical space. ── -->
    <HBox fx:id="offlineBanner" visible="false" managed="false"
          styleClass="offline-banner" alignment="CENTER_LEFT" spacing="10">
        <padding><Insets top="7" right="16" bottom="7" left="16"/></padding>
        <FontIcon fx:id="offlineBannerIcon" iconLiteral="mdi2c-cloud-off-outline" styleClass="offline-banner-icon"/>
        <Label fx:id="offlineBannerLabel" styleClass="offline-banner-text"
               text="Sin conexión — trabajando en modo offline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="offlineBannerSyncBtn" text="Sincronizar ahora"
                styleClass="offline-banner-btn" onAction="#onSyncNow">
            <tooltip><Tooltip text="Enviar los cambios locales al servidor cuando haya conexión"/></tooltip>
        </Button>
    </HBox>

    <!-- ── Main row: sidebar + content ──
         The sidebar is layered ON TOP of the content row (via the outer
         StackPane) rather than laid out beside it as a plain HBox sibling.
         The active nav button gets translateX'd a few px to the right (see
         SidebarManager#setActive) so it "invades" the content area —
         translateX doesn't affect layout, only paint position, so it needs
         the sidebar drawn above the content row to not get clipped by it.
         The base HBox below only exists to reserve the 220px of horizontal
         space with a transparent spacer. -->
    <StackPane fx:id="outerStack" VBox.vgrow="ALWAYS">
        <HBox>
            <Region fx:id="sidebarBackdrop" prefWidth="220" minWidth="220" maxWidth="220" styleClass="sidebar-backdrop"/>
            <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" styleClass="content-area"/>
        </HBox>

        <!-- ── Sidebar (drawn above the content row) ──
             Split into three parts: logo+user card pinned at top, the nav
             sections scrolling in the middle if the window is short, and
             the logout button + version pinned at the bottom — so the
             logout button can never be pushed off-screen by overflowing
             nav content the way it could when everything was one plain
             VBox with no scroll. -->
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="220" minWidth="220" maxWidth="220" spacing="0"
              StackPane.alignment="TOP_LEFT">

            <!-- Top row: logo + search icon + collapse. The header used to stack three rows (logo, account row,
                 full-width search field, ~150 px) before the first nav item; the account row now lives at the
                 bottom of the sidebar and search is an icon (Ctrl+K works from anywhere). Padding is in CSS
                 (.sidebar-logo-area): a stylesheet value beats one set in FXML. -->
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="sidebar-logo-area">
                <Label text="S" styleClass="sidebar-logo-badge"/>
                <VBox fx:id="logoTextBox" spacing="0" HBox.hgrow="ALWAYS">
                    <Label text="SIBIM" styleClass="sidebar-logo"/>
                    <Label text="Bienes Municipales" styleClass="sidebar-app-sub"/>
                </VBox>
                <Button fx:id="btnGlobalSearch" onAction="#onGlobalSearch"
                        styleClass="sidebar-icon-btn" contentDisplay="GRAPHIC_ONLY"
                        accessibleText="Búsqueda global">
                    <graphic><FontIcon iconLiteral="mdi2m-magnify" styleClass="nav-icon"/></graphic>
                    <tooltip><Tooltip text="Búsqueda global — Ctrl+K"/></tooltip>
                </Button>
                <Button fx:id="btnToggleSidebar" onAction="#onToggleSidebar"
                        styleClass="sidebar-icon-btn" contentDisplay="GRAPHIC_ONLY"
                        accessibleText="Contraer o expandir barra lateral">
                    <graphic><FontIcon iconLiteral="mdi2c-chevron-left" styleClass="nav-icon"/></graphic>
                    <tooltip><Tooltip text="Contraer/expandir barra lateral"/></tooltip>
                </Button>
            </HBox>

            <!-- Nav sections — each one folds like an accordion (see SidebarSections). The
                 buttons keep their fx:id, icon and tooltip here; what they DO (navigate, shortcut,
                 palette entry) is described once in MainController#buildNavRegistry. -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="sidebar-scroll">
                <!-- spacing comes from CSS (.nav-list): 0 expanded, a small gap in the icon rail. -->
                <VBox styleClass="nav-list">
                    <padding><Insets top="4" right="18" bottom="6" left="10"/></padding>

                    <VBox fx:id="secNavegacion" styleClass="nav-section">
                        <HBox styleClass="nav-section-header" alignment="CENTER_LEFT" spacing="6">
                            <Label text="NAVEGACIÓN" styleClass="nav-section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label styleClass="nav-section-badge" visible="false" managed="false" mouseTransparent="true"/>
                            <FontIcon iconLiteral="mdi2c-chevron-down" styleClass="nav-section-chevron"/>
                        </HBox>
                        <VBox styleClass="nav-section-items" spacing="3">
                            <Button fx:id="btnDashboard" text="Dashboard" onAction="#onNavItem" styleClass="nav-btn" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2v-view-dashboard" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Dashboard  (Ctrl+1)"/></tooltip>
                            </Button>
                            <Button fx:id="btnOrganigrama" text="Organigrama" onAction="#onNavItem" styleClass="nav-btn" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2s-sitemap" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Organigrama  (Ctrl+2)"/></tooltip>
                            </Button>
                            <Button fx:id="btnProductos" text="Bienes" onAction="#onNavItem" styleClass="nav-btn" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2p-package-variant" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Inventario de bienes  (Ctrl+3)"/></tooltip>
                            </Button>
                            <Button fx:id="btnCategorias" text="Categorías" onAction="#onNavItem" styleClass="nav-btn" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2t-tag-multiple" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Categorías de bienes  (Ctrl+4)"/></tooltip>
                            </Button>
                        </VBox>
                    </VBox>

                    <VBox fx:id="secOperaciones" styleClass="nav-section">
                        <HBox styleClass="nav-section-header" alignment="CENTER_LEFT" spacing="6">
                            <Label text="OPERACIONES" styleClass="nav-section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label styleClass="nav-section-badge" visible="false" managed="false" mouseTransparent="true"/>
                            <FontIcon iconLiteral="mdi2c-chevron-down" styleClass="nav-section-chevron"/>
                        </HBox>
                        <VBox styleClass="nav-section-items" spacing="3">
                            <Button fx:id="btnMovimientos" text="Movimientos" onAction="#onNavItem" styleClass="nav-btn, nav-ops" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2s-swap-vertical" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Historial de movimientos  (Ctrl+5)"/></tooltip>
                            </Button>
                            <StackPane maxWidth="Infinity" alignment="CENTER_RIGHT">
                                <Button fx:id="btnAlertas" text="Alertas" onAction="#onNavItem"
                                        styleClass="nav-btn, nav-ops" maxWidth="Infinity" StackPane.alignment="CENTER"
                                        contentDisplay="LEFT" graphicTextGap="10">
                                    <graphic><FontIcon iconLiteral="mdi2b-bell-alert" styleClass="nav-icon"/></graphic>
                                    <tooltip><Tooltip text="Alertas de inventario  (Ctrl+6)"/></tooltip>
                                </Button>
                                <Label fx:id="alertBadge" text="0"
                                       styleClass="alert-nav-badge"
                                       visible="false" managed="false" mouseTransparent="true"
                                       StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                            <Button fx:id="btnReportes" text="Reportes" onAction="#onNavItem" styleClass="nav-btn, nav-ops" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2f-file-chart" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Exportar reportes  (Ctrl+7)"/></tooltip>
                            </Button>
                            <Button fx:id="btnDepreciacion" text="Depreciación" onAction="#onNavItem" styleClass="nav-btn, nav-ops" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2c-chart-line" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Depreciación de activos  (Ctrl+8)"/></tooltip>
                            </Button>
                            <Button fx:id="btnConteoFisico" text="Conteo Físico" onAction="#onNavItem" styleClass="nav-btn, nav-ops" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2c-clipboard-search-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Tomar conteo físico del inventario  (Ctrl+Alt+C)"/></tooltip>
                            </Button>
                        </VBox>
                    </VBox>

                    <VBox fx:id="secControl" styleClass="nav-section">
                        <HBox styleClass="nav-section-header" alignment="CENTER_LEFT" spacing="6">
                            <Label text="CONTROL PATRIMONIAL" styleClass="nav-section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label styleClass="nav-section-badge" visible="false" managed="false" mouseTransparent="true"/>
                            <FontIcon iconLiteral="mdi2c-chevron-down" styleClass="nav-section-chevron"/>
                        </HBox>
                        <VBox styleClass="nav-section-items" spacing="3">
                            <Button fx:id="btnResguardos" text="Resguardos" onAction="#onNavItem" styleClass="nav-btn, nav-ctrl" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2b-badge-account-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Resguardos de bienes por servidor público  (Ctrl+Alt+G)"/></tooltip>
                            </Button>
                            <StackPane maxWidth="Infinity" alignment="CENTER_RIGHT">
                                <Button fx:id="btnPrestamos" text="Préstamos" onAction="#onNavItem"
                                        styleClass="nav-btn, nav-ctrl" maxWidth="Infinity" StackPane.alignment="CENTER"
                                        contentDisplay="LEFT" graphicTextGap="10">
                                    <graphic><FontIcon iconLiteral="mdi2c-cube-send" styleClass="nav-icon"/></graphic>
                                    <tooltip><Tooltip text="Préstamos temporales entre áreas  (Ctrl+Alt+P)"/></tooltip>
                                </Button>
                                <Label fx:id="loanBadge" text="0"
                                       styleClass="alert-nav-badge"
                                       visible="false" managed="false" mouseTransparent="true"
                                       StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                            <Button fx:id="btnComodatos" text="Comodatos" onAction="#onNavItem" styleClass="nav-btn, nav-ctrl" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2c-clipboard-list-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Comodatos — préstamos formales a entidades externas  (Ctrl+Alt+O)"/></tooltip>
                            </Button>
                            <Button fx:id="btnActas" text="Actas E/R" onAction="#onNavItem" styleClass="nav-btn, nav-ctrl" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2f-file-swap-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Actas de entrega-recepción  (Ctrl+Alt+A)"/></tooltip>
                            </Button>
                        </VBox>
                    </VBox>

                    <VBox fx:id="secSistema" styleClass="nav-section">
                        <HBox styleClass="nav-section-header" alignment="CENTER_LEFT" spacing="6">
                            <Label text="SISTEMA" styleClass="nav-section-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label styleClass="nav-section-badge" visible="false" managed="false" mouseTransparent="true"/>
                            <FontIcon iconLiteral="mdi2c-chevron-down" styleClass="nav-section-chevron"/>
                        </HBox>
                        <VBox styleClass="nav-section-items" spacing="3">
                            <Button fx:id="btnConfiguracion" text="Configuración" onAction="#onNavItem" styleClass="nav-btn, nav-sys" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2c-cog-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Configuración  (Ctrl+9)"/></tooltip>
                            </Button>
                            <Button fx:id="btnAuditoria" text="Auditoría" onAction="#onNavItem" styleClass="nav-btn, nav-sys" maxWidth="Infinity" contentDisplay="LEFT" graphicTextGap="10">
                                <graphic><FontIcon iconLiteral="mdi2s-shield-lock-outline" styleClass="nav-icon"/></graphic>
                                <tooltip><Tooltip text="Auditoría del sistema  (Ctrl+0)"/></tooltip>
                            </Button>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Pinned footer: the account row is always visible regardless of nav list length -->
            <Separator styleClass="sidebar-divider">
                <padding><Insets left="10" right="18"/></padding>
            </Separator>
            <!-- Account row: avatar + name over role, no box until hover. Click opens the account menu
                 (change password, tutorial, about, sign out — see MainUserMenu). In the icon rail only the
                 text hides; the avatar stays. -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-user-box">
                <VBox.margin><Insets top="6" right="18" bottom="10" left="10"/></VBox.margin>
                <StackPane styleClass="user-avatar">
                    <Label fx:id="userAvatarLabel" text="U" styleClass="user-avatar-text"/>
                </StackPane>
                <VBox fx:id="userInfoVBox" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="1">
                    <Label fx:id="userNameLabel" styleClass="sidebar-username" maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                    <Label fx:id="userRolLabel" styleClass="sidebar-userrole" maxWidth="Infinity" textOverrun="ELLIPSIS"/>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>

    <!-- ── Status bar ── -->
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="5" right="16" bottom="5" left="16"/></padding>
        <HBox fx:id="statusDbPill" alignment="CENTER_LEFT" spacing="7" styleClass="status-db-pill">
            <FontIcon fx:id="statusDotIcon" iconLiteral="mdi2d-database-check-outline" iconSize="14" styleClass="status-dot-icon-ok"/>
            <Label fx:id="statusDbLabel" text="Conectado" styleClass="status-text, status-db-label"/>
            <Label fx:id="statusDbHelpBadge" text="?" styleClass="status-db-help-badge">
                <tooltip><Tooltip fx:id="statusDbTooltip" text="Base de datos conectada (Supabase). Los cambios se guardan en tiempo real." wrapText="true" maxWidth="230"/></tooltip>
            </Label>
        </HBox>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <Label fx:id="statusUserLabel" text="—" styleClass="status-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="SIBIM v12.3.5" styleClass="sidebar-version"/>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <Label text="⌨ Atajos (F1)" styleClass="status-shortcut-hint" onMouseClicked="#onShowShortcuts"
               accessibleRole="BUTTON" accessibleText="Ver atajos de teclado">
            <tooltip><Tooltip text="Ver todos los atajos de teclado  ·  F2 = Tutorial"/></tooltip>
        </Label>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <StackPane>
            <Button fx:id="btnNotificaciones" styleClass="btn-icon-only" contentDisplay="GRAPHIC_ONLY"
                    accessibleText="Notificaciones">
                <graphic><FontIcon iconLiteral="mdi2b-bell-outline" styleClass="status-icon"/></graphic>
                <tooltip><Tooltip text="Notificaciones — alertas de stock y préstamos vencidos"
                                  wrapText="true" maxWidth="240"/></tooltip>
            </Button>
            <Label fx:id="notifBadge" text="0" styleClass="notif-bell-badge"
                   visible="false" managed="false" mouseTransparent="true"
                   StackPane.alignment="TOP_RIGHT"/>
        </StackPane>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <Button fx:id="btnDensity" onAction="#onToggleDensity" styleClass="density-btn"
                text="Normal" graphicTextGap="5" contentDisplay="LEFT">
            <graphic><FontIcon iconLiteral="mdi2v-view-list" styleClass="status-icon"/></graphic>
            <tooltip><Tooltip text="Densidad de filas: Compacto → Normal → Cómodo"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <Button fx:id="btnTextSize" onAction="#onToggleTextSize" styleClass="density-btn"
                text="Normal" graphicTextGap="5" contentDisplay="LEFT">
            <graphic><FontIcon iconLiteral="mdi2f-format-size" styleClass="status-icon"/></graphic>
            <tooltip><Tooltip text="Tamaño de texto: Normal → Grande → Extra grande" wrapText="true" maxWidth="220"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL" styleClass="status-separator"/>
        <Label fx:id="statusTimeLabel" text="00:00" styleClass="status-time"/>
    </HBox>
</VBox>
