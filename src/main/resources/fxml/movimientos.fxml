<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.MovimientosController"
      fx:id="rootPane" spacing="12">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-purple">
        <!-- Icon badge -->
        <StackPane styleClass="page-header-icon page-header-icon-purple">
            <Label text="↕" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Movimientos de Stock" styleClass="page-title"/>
            <Label text="Historial de entradas, salidas, ajustes y transferencias" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
        <Button text="↺ Actualizar" onAction="#onRefresh" styleClass="btn-secondary">
            <tooltip><Tooltip text="Actualizar desde la base de datos (F5)"/></tooltip>
        </Button>
        <Button fx:id="btnNuevo" text="＋ Nuevo Movimiento" onAction="#onNuevoMovimiento" styleClass="btn-primary">
            <tooltip><Tooltip text="Registrar entrada, salida, ajuste o transferencia  (Ctrl+N)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ SECCIÓN RESUMEN ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar-purple"/>
        <Label text="RESUMEN DE MOVIMIENTOS" styleClass="dash-section-label"/>
    </HBox>

    <!-- ══ STAT CARDS ═══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <!-- Total movimientos — purple -->
        <VBox fx:id="statCardTotal" styleClass="rich-stat-card, rich-stat-purple"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-purple">
                    <Label text="↕" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="TOTAL MOVIMIENTOS" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatTotalMov" text="—" styleClass="rich-stat-value"/>
            <Label text="en el período filtrado" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Entradas — green -->
        <VBox fx:id="statCardEntrada" styleClass="rich-stat-card, rich-stat-green"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-green">
                    <Label text="⬆" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="ENTRADAS" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatEntradas" text="—" styleClass="rich-stat-value"/>
            <Label text="incrementan el stock" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Salidas — red -->
        <VBox fx:id="statCardSalida" styleClass="rich-stat-card, rich-stat-red"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-red">
                    <Label text="⬇" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="SALIDAS" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatSalidas" text="—" styleClass="rich-stat-value"/>
            <Label text="reducen el stock" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Ajustes / Transferencias — amber -->
        <VBox fx:id="statCardAjuste" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <Label text="⇄" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="AJUSTES / TRANSF." styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatAjustes" text="—" styleClass="rich-stat-value"/>
            <Label text="ajustes y transferencias" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>

    <!-- ══ BUSCAR Y FILTRAR ════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar-purple"/>
        <Label text="BUSCAR Y FILTRAR" styleClass="dash-section-label"/>
    </HBox>

    <!-- ══ FILTER BAR ════════════════════════════════════════════════ -->
    <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" styleClass="filter-bar filter-bar-purple">
        <StackPane prefWidth="280">
            <TextField fx:id="searchField"
                       promptText="🔍  Buscar por producto, motivo o referencia..."
                       maxWidth="Infinity" styleClass="search-field"/>
            <Button fx:id="btnClearSearch" text="✕" styleClass="search-clear-btn"
                    StackPane.alignment="CENTER_RIGHT" visible="false" managed="false">
                <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
            </Button>
        </StackPane>
        <Separator orientation="VERTICAL"/>
        <!-- Tipo filter chips (populated by controller) -->
        <HBox fx:id="tipoChipsBar" spacing="5" alignment="CENTER_LEFT"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Desde:" styleClass="muted"/>
        <DatePicker fx:id="desdeFilter" prefWidth="130" promptText="dd/mm/aaaa">
            <tooltip><Tooltip text="Fecha inicial del rango"/></tooltip>
        </DatePicker>
        <Label text="Hasta:" styleClass="muted"/>
        <DatePicker fx:id="hastaFilter" prefWidth="130" promptText="dd/mm/aaaa">
            <tooltip><Tooltip text="Fecha final del rango"/></tooltip>
        </DatePicker>
        <Button fx:id="btnPresetHoy"    text="Hoy"    onAction="#onPresetHoy"    styleClass="btn-preset">
            <tooltip><Tooltip text="Ver movimientos de hoy"/></tooltip>
        </Button>
        <Button fx:id="btnPresetSemana" text="Semana" onAction="#onPresetSemana" styleClass="btn-preset">
            <tooltip><Tooltip text="Ver movimientos de los últimos 7 días"/></tooltip>
        </Button>
        <Button fx:id="btnPresetMes"    text="Mes"    onAction="#onPresetMes"    styleClass="btn-preset">
            <tooltip><Tooltip text="Ver movimientos del mes actual"/></tooltip>
        </Button>
        <Button text="✕" onAction="#onLimpiarFechas" styleClass="btn-preset-clear">
            <tooltip><Tooltip text="Limpiar filtros de fecha"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button text="CSV"   onAction="#onExportCsv"   styleClass="btn-csv">
            <tooltip><Tooltip text="Exportar movimientos filtrados a CSV"/></tooltip>
        </Button>
        <Button text="Excel" onAction="#onExportExcel" styleClass="btn-excel">
            <tooltip><Tooltip text="Exportar movimientos filtrados a Excel (.xlsx)"/></tooltip>
        </Button>
    </FlowPane>

    <!-- ══ DATA TABLE ════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colProducto"   text="Bien / Producto"    prefWidth="200" sortable="true"/>
            <TableColumn fx:id="colTipo"       text="Tipo"               prefWidth="115" sortable="true"/>
            <TableColumn fx:id="colCantidad"   text="Cantidad"           prefWidth="80"  sortable="true"/>
            <TableColumn fx:id="colStock"      text="Stock Ant. → Nuevo" prefWidth="148" sortable="false"/>
            <TableColumn fx:id="colMotivo"     text="Motivo"             prefWidth="165" sortable="true"/>
            <TableColumn fx:id="colReferencia" text="Referencia"         prefWidth="108" sortable="true"/>
            <TableColumn fx:id="colUsuario"    text="Usuario"            prefWidth="128" sortable="true"/>
            <TableColumn fx:id="colFecha"      text="Fecha"              prefWidth="130" sortable="true"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <Label text="↕" styleClass="empty-icon-lg"/>
                <Label text="No hay movimientos que mostrar" styleClass="empty-state-msg"/>
                <Label text="Ajusta los filtros o registra un nuevo movimiento con ＋" styleClass="empty-state-hint"/>
            </VBox>
        </placeholder>
    </TableView>

    <!-- ══ BOTTOM ACTION BAR ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bottom-action-bar">
        <Label fx:id="lblTotal" text="0 movimientos" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnDelete" text="✕  Eliminar" onAction="#onDelete" styleClass="btn-danger" disable="true">
            <tooltip><Tooltip text="Eliminar el movimiento seleccionado (irreversible)"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnPrev" text="‹" onAction="#onPrev" styleClass="pagination-btn"/>
        <Label fx:id="lblPage" text="Página 1" styleClass="pagination-lbl"/>
        <Button fx:id="btnNext" text="›" onAction="#onNext" styleClass="pagination-btn"/>
        <ComboBox fx:id="pageSizeBox" prefWidth="82">
            <tooltip><Tooltip text="Movimientos por página"/></tooltip>
        </ComboBox>
    </HBox>
</VBox>
