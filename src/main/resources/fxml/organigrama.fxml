<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.OrganigramaController"
      spacing="12">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-blue">
        <StackPane styleClass="page-header-icon page-header-icon-blue">
            <FontIcon iconLiteral="mdi2o-office-building-outline" styleClass="page-icon-emoji"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Organigrama Municipal" styleClass="page-title"/>
            <Label text="Distribución de bienes por secretaría y dirección" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="24" prefHeight="24"
                           visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Recargar distribución de bienes por área (F5)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ STAT CARDS ═══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <VBox fx:id="statCardAreas" styleClass="rich-stat-card, rich-stat-indigo"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2o-office-building-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="ÁREAS CON BIENES" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatAreas" text="—" styleClass="rich-stat-value"/>
            <Label text="de la estructura municipal" styleClass="rich-stat-hint"/>
        </VBox>

        <VBox fx:id="statCardBienes" styleClass="rich-stat-card, rich-stat-teal"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2p-package-variant" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="BIENES DISTRIBUIDOS" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatBienes" text="—" styleClass="rich-stat-value"/>
            <Label text="en todas las áreas" styleClass="rich-stat-hint"/>
        </VBox>

        <VBox fx:id="statCardTop" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <FontIcon iconLiteral="mdi2s-star-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="ÁREA CON MÁS BIENES" styleClass="rich-stat-label"/>
            </HBox>
            <Label fx:id="lblStatTopArea" text="—" styleClass="rich-stat-value, rich-stat-value-sm"/>
            <Label text="mayor concentración de inventario" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>

    <!-- ══ SEARCH BAR ════════════════════════════════════════════════ -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <StackPane HBox.hgrow="ALWAYS">
            <TextField fx:id="searchField"
                       promptText="🔍  Buscar área, secretaría o departamento..."
                       maxWidth="Infinity" styleClass="search-field"/>
            <Button fx:id="btnClearSearch" text="" styleClass="search-clear-btn"
                    StackPane.alignment="CENTER_RIGHT" visible="false" managed="false">
                <graphic><FontIcon iconLiteral="mdi2c-close"/></graphic>
                <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
            </Button>
        </StackPane>
        <Label text="Expande cada sección para ver los bienes asignados"
               styleClass="muted-sm"/>
        <Button text="Expandir todo" onAction="#onExpandAll" styleClass="btn-secondary btn-sm">
            <tooltip><Tooltip text="Expande todas las secciones visibles"/></tooltip>
        </Button>
        <Button text="Colapsar todo" onAction="#onCollapseAll" styleClass="btn-secondary btn-sm">
            <tooltip><Tooltip text="Colapsa todas las secciones visibles"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ ORG TREE ═══════════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll page-scroll-inner">
        <VBox fx:id="orgTree" spacing="8">
            <padding><Insets top="4" right="0" bottom="8" left="0"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
