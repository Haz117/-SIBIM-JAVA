<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.ProductosController"
      fx:id="rootPane" spacing="9">
    <padding><Insets top="16" right="22" bottom="16" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header, page-header-indigo">
        <!-- Icon badge -->
        <StackPane styleClass="page-header-icon, page-header-icon-indigo">
            <FontIcon iconLiteral="mdi2p-package-variant" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Bienes Patrimoniales" styleClass="page-title"/>
            <Label text="Inventario de bienes del H. Ayuntamiento de Ixmiquilpan" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-ghost"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Actualizar lista (F5)"/></tooltip>
        </Button>
        <!-- What is used now and then lives here, so the header keeps only what is used all day. -->
        <MenuButton fx:id="btnMasBienes" text="Más" styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-dots-horizontal" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Bajas, conteo físico, importación y revisión de los datos"/></tooltip>
            <items>
                <MenuItem text="Bienes dados de baja" onAction="#onVerBajas">
                    <graphic><FontIcon iconLiteral="mdi2d-delete-restore"/></graphic>
                </MenuItem>
                <MenuItem text="Resguardos por área (PDF)" onAction="#onResguardoArea">
                    <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box"/></graphic>
                </MenuItem>
                <SeparatorMenuItem/>
                <MenuItem fx:id="btnConteoFisico" text="Conteo físico de los bienes filtrados" onAction="#onConteoFisico">
                    <graphic><FontIcon iconLiteral="mdi2c-clipboard-check-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnImportar" text="Importar bienes desde CSV o Excel" onAction="#onImportarCsv">
                    <graphic><FontIcon iconLiteral="mdi2u-upload-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnEtiquetasArea" text="Etiquetas por área" onAction="#onEtiquetasArea">
                    <graphic><FontIcon iconLiteral="mdi2t-tag-multiple-outline"/></graphic>
                </MenuItem>
                <!-- Patrimonio's, by what they need at hand (19-nov-2026: 14 options in a row). -->
                <SeparatorMenuItem fx:id="sepRevisarDatos"/>
                <MenuItem fx:id="secFactura" text="Completar y corregir, con la factura" disable="true" styleClass="menu-seccion"/>
                <MenuItem fx:id="btnLoSeguro" text="Lo seguro, de una vez…" onAction="#onLoSeguro">
                    <graphic><FontIcon iconLiteral="mdi2c-check-decagram"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnCompletarDatos" text="Completar datos" onAction="#onCompletarDatos">
                    <graphic><FontIcon iconLiteral="mdi2c-clipboard-edit-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnCompletarFactura" text="Completar por factura" onAction="#onCompletarFactura">
                    <graphic><FontIcon iconLiteral="mdi2r-receipt"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnCompletarGrupos" text="Completar por grupos (mismo nombre)" onAction="#onCompletarGrupos">
                    <graphic><FontIcon iconLiteral="mdi2f-format-list-checks"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnFotosCarpeta" text="Fotos de una carpeta…" onAction="#onFotosCarpeta">
                    <graphic><FontIcon iconLiteral="mdi2c-camera-burst"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnFacturasCarpeta" text="Leer las facturas de una carpeta…" onAction="#onFacturasCarpeta">
                    <graphic><FontIcon iconLiteral="mdi2f-file-document-multiple-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnMismaFactura" text="Copiar datos de la misma factura" onAction="#onMismaFactura">
                    <graphic><FontIcon iconLiteral="mdi2r-receipt"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnFolioFiscal" text="Folio fiscal a su lugar" onAction="#onFolioFiscal">
                    <graphic><FontIcon iconLiteral="mdi2f-file-swap-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnCostosDistintos" text="Costos distintos en la misma compra" onAction="#onCostosDistintos">
                    <graphic><FontIcon iconLiteral="mdi2s-scale-balance"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnResidual" text="Valor residual: el 15 % del costo" onAction="#onPonerResidual">
                    <graphic><FontIcon iconLiteral="mdi2c-cash-check"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnCostoLotes" text="Costo de los lotes (piezas × costo)" onAction="#onCostoLotes">
                    <graphic><FontIcon iconLiteral="mdi2c-calculator-variant-outline"/></graphic>
                </MenuItem>
                <SeparatorMenuItem fx:id="sepEscrito"/>
                <MenuItem fx:id="secEscrito" text="Lo escrito de varias formas" disable="true" styleClass="menu-seccion"/>
                <MenuItem fx:id="btnUnirProveedores" text="Unir lo escrito de dos formas" onAction="#onUnirProveedores">
                    <graphic><FontIcon iconLiteral="mdi2s-spellcheck"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnUnirPersonas" text="Unir personas repetidas" onAction="#onUnirPersonas">
                    <graphic><FontIcon iconLiteral="mdi2a-account-multiple-check-outline"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnQuitarTitulos" text="Quitar títulos de los nombres (Lic., Ing.…)" onAction="#onQuitarTitulos">
                    <graphic><FontIcon iconLiteral="mdi2c-card-account-details-outline"/></graphic>
                </MenuItem>
                <SeparatorMenuItem fx:id="sepRepetidos"/>
                <MenuItem fx:id="secRepetidos" text="Repetidos" disable="true" styleClass="menu-seccion"/>
                <MenuItem fx:id="btnJuntarBienes" text="Son el mismo bien (juntar dos registros)…" onAction="#onJuntarBienes">
                    <graphic><FontIcon iconLiteral="mdi2c-call-merge"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnSeriesRepetidas" text="Series repetidas" onAction="#onSeriesRepetidas">
                    <graphic><FontIcon iconLiteral="mdi2b-barcode-scan"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnFotosRepetidas" text="Fotos repetidas" onAction="#onFotosRepetidas">
                    <graphic><FontIcon iconLiteral="mdi2i-image-multiple-outline"/></graphic>
                </MenuItem>
            </items>
        </MenuButton>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnToggleResumen" styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-up" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Muestra u oculta las tarjetas de resumen para dar más espacio a la tabla" wrapText="true" maxWidth="240"/></tooltip>
        </Button>
        <Button fx:id="btnNuevoBien" text="Nuevo Bien" onAction="#onNuevoBien" styleClass="btn-primary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2p-plus" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Registrar un nuevo bien en el inventario  (Ctrl+N)"/></tooltip>
        </Button>
    </HBox>

    <VBox fx:id="resumenBox" spacing="9">
    <!-- ══ SECCIÓN RESUMEN ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="RESUMEN DEL INVENTARIO" styleClass="dash-section-label"/>
    </HBox>

    <!-- ══ STAT CARDS ═══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <!-- Total de Bienes — indigo -->
        <VBox fx:id="statCardTotal" styleClass="rich-stat-card, rich-stat-indigo"
              HBox.hgrow="ALWAYS" spacing="3" alignment="CENTER_LEFT">
            <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2c-cube-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="TOTAL DE BIENES" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpTotal" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Total de bienes activos registrados en el inventario, dados de baja excluidos." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatTotal" text="—" styleClass="rich-stat-value"/>
            <Label text="bienes patrimoniales" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Valor del Inventario — teal -->
        <VBox fx:id="statCardValor" styleClass="rich-stat-card, rich-stat-teal"
              HBox.hgrow="ALWAYS" spacing="3" alignment="CENTER_LEFT">
            <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2c-currency-usd" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="VALOR DEL INVENTARIO" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpValor" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Suma del costo de adquisición × cantidad de todos los bienes activos del inventario." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatValor" text="—" styleClass="rich-stat-value, rich-stat-value-sm"/>
            <Label text="costo de adquisición × cantidad" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Bienes con Alerta — amber -->
        <VBox fx:id="cardAlertas" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="3" alignment="CENTER_LEFT">
            <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <FontIcon iconLiteral="mdi2b-bell-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="GARANTÍA VENCIDA" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="helpAlertas" text="?" styleClass="help-badge">
                    <tooltip><Tooltip text="Bienes cuya garantía ya venció." wrapText="true" maxWidth="240"/></tooltip>
                </Label>
            </HBox>
            <Label fx:id="lblStatAlertas" text="—" styleClass="rich-stat-value"/>
            <Label text="bienes con garantía vencida" styleClass="rich-stat-hint"/>
        </VBox>

        <!-- Sin Etiquetar — rose -->
        <VBox fx:id="cardSinEtiquetar" styleClass="rich-stat-card, rich-stat-slate"
              HBox.hgrow="ALWAYS" spacing="3" alignment="CENTER_LEFT">
            <padding><Insets top="11" right="18" bottom="11" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-slate">
                    <FontIcon iconLiteral="mdi2t-tag-off-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="SIN ETIQUETAR" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatSinEtiquetar" text="—" styleClass="rich-stat-value"/>
            <Label text="bienes sin etiqueta física" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>
    </VBox>

    <!-- ══ BUSCAR Y FILTRAR ════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="BUSCAR Y FILTRAR" styleClass="dash-section-label"/>
        <!-- Search stays in this row so collapsing the filters never hides it. -->
        <StackPane prefWidth="460" maxWidth="560" HBox.hgrow="ALWAYS">
            <TextField fx:id="searchField"
                       promptText="Buscar por nombre, código, número anterior, factura, serie, marca, resguardante…"
                       maxWidth="Infinity" styleClass="search-field"/>
            <Button fx:id="btnClearSearch" text="" styleClass="search-clear-btn"
                    StackPane.alignment="CENTER_RIGHT" visible="false"
                    accessibleText="Limpiar búsqueda">
                <graphic><FontIcon iconLiteral="mdi2c-close"/></graphic>
                <tooltip><Tooltip text="Limpiar búsqueda"/></tooltip>
            </Button>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnToggleFiltros" styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-up" styleClass="btn-icon"/></graphic>
        </Button>
    </HBox>

    <!-- ══ FILTER BAR (collapsible) ════════════════════════════════════════════════ -->
    <FlowPane fx:id="filterBar" hgap="10" vgap="8" alignment="CENTER_LEFT" styleClass="filter-bar, filter-bar-indigo">
        <ComboBox fx:id="categoriaFilter" promptText="Todas las categorías" prefWidth="165"/>
        <ComboBox fx:id="areaFilter" promptText="Todas las áreas" prefWidth="190"/>
        <ComboBox fx:id="resguardanteFilter" promptText="Resguardante..." prefWidth="165"/>
        <Label fx:id="helpResguardante" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Resguardante: persona responsable de la custodia del bien. Filtrar por encargado."/></tooltip>
        </Label>
        <Separator orientation="VERTICAL"/>
        <!-- The whole range wraps as one: the row break used to leave "Registrado desde"
             at the end of one line and "hasta" on the next. -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Registrado:" styleClass="form-label"/>
            <DatePicker fx:id="desdeRegFilter" prefWidth="130" promptText="Desde" onAction="#onFiltroFechaReg"/>
            <DatePicker fx:id="hastaRegFilter" prefWidth="130" promptText="Hasta" onAction="#onFiltroFechaReg"/>
            <Button onAction="#onLimpiarFechaReg" styleClass="btn-secondary"
                    prefWidth="28" prefHeight="28">
                <graphic><FontIcon iconLiteral="mdi2c-close" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Limpiar filtro de fechas de registro"/></tooltip>
            </Button>
        </HBox>
        <Label fx:id="helpFechaReg" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Filtra por la fecha en que el bien fue registrado en el sistema (no la fecha de compra). Deja un campo vacío para no acotar ese extremo del rango." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
        <Separator orientation="VERTICAL"/>
        <!-- Status filter chips (populated by controller) -->
        <HBox fx:id="statusChipsBar" spacing="5" alignment="CENTER_LEFT"/>
        <Label fx:id="helpChips" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Filtra por la garantía del bien:&#10;• Sin vencer — garantía vigente, o sin garantía registrada&#10;• Vencida — la garantía ya venció&#10;&#10;Se combina con el resto de filtros activos." wrapText="true" maxWidth="280"/></tooltip>
        </Label>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnClearFilters" text="Limpiar filtros" onAction="#onClearFilters"
                styleClass="btn-secondary" visible="false" managed="false"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2c-close" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Quitar todos los filtros activos"/></tooltip>
        </Button>
        <Button fx:id="btnGuardarPreset" text="Guardar filtro" onAction="#onGuardarPreset"
                styleClass="btn-secondary" visible="false" managed="false"
                contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2b-bookmark-plus-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Guardar la combinación de filtros actual como acceso rápido"/></tooltip>
        </Button>
    </FlowPane>

    <!-- ══ ACTIVE FILTER CHIPS ══════════════════════════════════════ -->
    <FlowPane fx:id="activeChipsBar" hgap="6" vgap="4" alignment="CENTER_LEFT"
              styleClass="active-chips-bar" visible="false" managed="false"/>

    <!-- ══ PRESET BAR ══════════════════════════════════════════════ -->
    <HBox fx:id="presetsHeader" alignment="CENTER_LEFT" spacing="8"
          visible="false" managed="false">
        <Region styleClass="dash-section-bar"/>
        <Label text="ACCESOS RÁPIDOS" styleClass="dash-section-label"/>
        <Label fx:id="helpPresets" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Guarda la combinación actual de filtros (búsqueda, categoría, área, estado...) con un nombre para abrirla con un clic. Ideal para búsquedas frecuentes como 'Vehículos sin etiquetar' o 'Área Obras'. El botón 'Guardar filtro' aparece cuando hay filtros activos." wrapText="true" maxWidth="290"/></tooltip>
        </Label>
    </HBox>
    <FlowPane fx:id="presetsBar" hgap="6" vgap="6" alignment="CENTER_LEFT"
              styleClass="preset-bar" visible="false" managed="false"/>

    <!-- ══ SECCIÓN TABLA ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="TABLA DE BIENES" styleClass="dash-section-label"/>
        <Label fx:id="lblPistaAcciones" text="Selecciona un bien: abajo se activa lo que puedes hacer con él" styleClass="muted-sm"/>
        <Label fx:id="helpColumnas" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="▸ Columnas: usa el botón ⋮ (arriba a la derecha de la tabla) o clic derecho en el encabezado para mostrar u ocultar columnas. Con 'Restaurar columnas' vuelven a como venían." wrapText="true" maxWidth="310"/></tooltip>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnResetColumns" text="Restaurar columnas" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2t-table-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Regresa las columnas a como venían: cuáles se ven, su orden y su ancho" wrapText="true" maxWidth="260"/></tooltip>
        </Button>
        <MenuButton fx:id="btnExportar" text="Exportar" styleClass="btn-secondary"
                    contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-download-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Exportar los bienes de la lista filtrada, o solo los seleccionados (Ctrl+clic o Shift+clic para elegir varios)" wrapText="true" maxWidth="260"/></tooltip>
            <items>
                <MenuItem text="Lista filtrada — CSV" onAction="#onExportCsv">
                    <graphic><FontIcon iconLiteral="mdi2f-file-delimited-outline" styleClass="report-export-icon-csv"/></graphic>
                </MenuItem>
                <MenuItem text="Lista filtrada — Excel" onAction="#onExportExcel">
                    <graphic><FontIcon iconLiteral="mdi2f-file-excel-outline" styleClass="report-export-icon-excel"/></graphic>
                </MenuItem>
                <SeparatorMenuItem/>
                <Menu fx:id="btnExportarSeleccion" text="Solo los seleccionados" disable="true">
                    <items>
                        <MenuItem text="Ficha técnica (PDF)" onAction="#onExportSeleccionFicha">
                            <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="report-export-icon-pdf"/></graphic>
                        </MenuItem>
                        <MenuItem text="Solicitud de baja (PDF)" onAction="#onExportSolicitudBaja">
                            <graphic><FontIcon iconLiteral="mdi2f-file-remove-outline" styleClass="report-export-icon-pdf"/></graphic>
                        </MenuItem>
                        <MenuItem text="Dictamen técnico de baja (PDF)" onAction="#onExportDictamenBaja">
                            <graphic><FontIcon iconLiteral="mdi2f-file-certificate-outline" styleClass="report-export-icon-pdf"/></graphic>
                        </MenuItem>
                        <MenuItem text="CSV" onAction="#onExportSeleccionCsv">
                            <graphic><FontIcon iconLiteral="mdi2f-file-delimited-outline" styleClass="report-export-icon-csv"/></graphic>
                        </MenuItem>
                        <MenuItem text="Excel" onAction="#onExportSeleccionExcel">
                            <graphic><FontIcon iconLiteral="mdi2f-file-excel-outline" styleClass="report-export-icon-excel"/></graphic>
                        </MenuItem>
                    </items>
                </Menu>
            </items>
        </MenuButton>
    </HBox>

    <!-- ══ DATA TABLE ════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table" tableMenuButtonVisible="true">
        <!-- Minimum widths fit real content (a full código, a category badge, an área
             name) so a narrow window scrolls sideways instead of turning every cell into "…".
             The name asks for the most (17-nov-2026: at 1366 it got 160 px, «Archivero metálico…»):
             ColumnasLegibles shares the width by what each column asks for. -->
        <columns>
            <TableColumn fx:id="colFoto"      text="Foto"             prefWidth="62"  minWidth="62" maxWidth="62"  sortable="false" resizable="false"/>
            <TableColumn fx:id="colNombre"    text="Nombre"          prefWidth="420" maxWidth="640" sortable="true" minWidth="260"/>
            <TableColumn fx:id="colCodigo"    text="Código"          prefWidth="120" sortable="true" minWidth="100"/>
            <TableColumn fx:id="colCategoria" text="Categoría"       prefWidth="170" sortable="true" minWidth="150"/>
            <TableColumn fx:id="colArea"      text="Área / Dirección" prefWidth="210" maxWidth="260" sortable="true" minWidth="150"/>
            <TableColumn fx:id="colResguardante" text="Resguardante" prefWidth="190" maxWidth="240" sortable="true" minWidth="130"/>
            <TableColumn fx:id="colStock"     text="Cant."              prefWidth="64"  sortable="true" minWidth="60"/>
            <TableColumn fx:id="colValor"     text="Valor Unit."     prefWidth="115" minWidth="100" sortable="true"/>
            <TableColumn fx:id="colEstado"    text="Garantía"          prefWidth="110" sortable="true" minWidth="100" visible="false"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <FontIcon iconLiteral="mdi2p-package-variant" styleClass="empty-icon-lg"/>
                <Label text="No hay bienes registrados" styleClass="empty-state-msg"/>
                <Label text="Usa el botón ＋ Nuevo Bien para registrar el primer activo" styleClass="empty-state-hint"/>
            </VBox>
        </placeholder>
    </TableView>

    <!-- ══ BULK ACTION BAR (visible when ≥2 rows selected) ════════════ -->
    <HBox fx:id="bulkBar" alignment="CENTER_LEFT" spacing="8"
          styleClass="bulk-action-bar" visible="false" managed="false">
        <FontIcon iconLiteral="mdi2c-checkbox-multiple-marked-outline" styleClass="bulk-bar-icon"/>
        <Label fx:id="lblBulkCount" text="" styleClass="bulk-count-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- The same data for all of them at once (EditarVarios): first, it is what is done most. -->
        <Button fx:id="btnBulkDatos" text="Cambiar datos" onAction="#onBulkCambiarDatos"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2p-pencil-box-multiple-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Poner los mismos datos (proveedor, factura, color, vida útil…) a todos los bienes seleccionados a la vez"/></tooltip>
        </Button>
        <!-- The same board as the Transferir button above (motivo, resguardo, Deshacer). -->
        <Button fx:id="btnBulkArea" text="Transferir" onAction="#onTransferir"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2d-drag-variant" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Llevar los bienes seleccionados a otra área"/></tooltip>
        </Button>
        <Button fx:id="btnBulkResguardante" text="Cambiar resguardante" onAction="#onBulkCambiarResguardante"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2a-account-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Asignar un nuevo resguardante a todos los bienes seleccionados"/></tooltip>
        </Button>
        <Button text="Resguardo PDF" onAction="#onBulkResguardoPdf"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Genera un PDF de resguardo con los bienes seleccionados: uno por cada resguardante. Si solo son vehículos, sale la hoja oficial de cada vehículo"/></tooltip>
        </Button>
        <!-- The two of the labels in one menu, as «Etiqueta» above: with «Cambiar datos» the bar
             no longer fit at 1366 px and the buttons were cut («Transf…»). -->
        <MenuButton fx:id="btnBulkEtiquetas" text="Etiquetas" styleClass="btn-secondary" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2t-tag-multiple-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Imprimir las etiquetas QR de los seleccionados o marcarlos como etiquetados"/></tooltip>
            <items>
                <MenuItem text="Imprimir etiquetas QR (PDF)" onAction="#onBulkEtiquetasQr">
                    <graphic><FontIcon iconLiteral="mdi2q-qrcode"/></graphic>
                </MenuItem>
                <MenuItem fx:id="btnBulkMarcarEtiquetado" text="Marcar como etiquetados" onAction="#onBulkMarcarEtiquetado">
                    <graphic><FontIcon iconLiteral="mdi2t-tag-multiple-outline"/></graphic>
                </MenuItem>
            </items>
        </MenuButton>
        <Button fx:id="btnComparar" text="Comparar" onAction="#onComparar"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6"
                visible="false" managed="false">
            <graphic><FontIcon iconLiteral="mdi2c-compare" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Comparar los dos bienes seleccionados campo a campo — selecciona exactamente 2"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button text="Deseleccionar" onAction="#onDeseleccionar" styleClass="btn-secondary"
                contentDisplay="GRAPHIC_ONLY" accessibleText="Quitar la selección">
            <graphic><FontIcon iconLiteral="mdi2c-close" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Quitar la selección de todos los bienes marcados"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ BOTTOM ACTION BAR ══════════════════════════════════════════ -->
    <!-- 8 px between items: with 12 the buttons lost their names at 1280 px. -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="bottom-action-bar">
        <Label fx:id="lblTotal" text="0 resultados" styleClass="muted"/>
        <Label fx:id="lblTotalAll" text="" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnMovimiento" text="Transferir" onAction="#onTransferir" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-drag-variant" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Abre «Transferir bienes» con los bienes seleccionados ya elegidos, para llevarlos a otra área" wrapText="true" maxWidth="260"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <MenuButton fx:id="btnFicha" text="Ficha" styleClass="btn-secondary" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2f-file-document-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Formatos en PDF de los bienes seleccionados, con su fotografía" wrapText="true" maxWidth="260"/></tooltip>
            <items>
                <MenuItem text="Ficha técnica (foto, datos, QR y movimientos)" onAction="#onExportSeleccionFicha"/>
                <MenuItem text="Inventario fotográfico (inventario digital)" onAction="#onExportInventarioFotografico"/>
            </items>
        </MenuButton>
        <MenuButton fx:id="btnEtiqueta" text="Etiqueta" styleClass="btn-secondary" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2t-tag-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Imprimir la etiqueta del bien seleccionado (o de todos los seleccionados)" wrapText="true" maxWidth="260"/></tooltip>
            <items>
                <!-- "QR" was a button of its own next to this menu's "Etiqueta QR": the code of a
                     bien and its labels, all here. -->
                <MenuItem fx:id="miVerQr" text="Ver el código QR (de un bien)" onAction="#onImprimirQr">
                    <graphic><FontIcon iconLiteral="mdi2q-qrcode"/></graphic>
                </MenuItem>
                <SeparatorMenuItem/>
                <MenuItem text="Etiqueta de inventario (formato oficial)" onAction="#onEtiquetaFisicaSeleccion"/>
                <MenuItem text="Etiqueta QR" onAction="#onEtiquetaQrSeleccion"/>
            </items>
        </MenuButton>
        <Button fx:id="btnEditar" text="Editar" onAction="#onEdit" styleClass="btn-secondary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2p-pencil" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Editar el bien seleccionado (o doble clic)"/></tooltip>
        </Button>
        <Button fx:id="btnEliminar" text="Dar de baja" onAction="#onDelete" styleClass="btn-danger"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-delete-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Dar de baja el bien seleccionado (baja patrimonial formal, con motivo)"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnPrev" onAction="#onPrev" styleClass="pagination-btn" contentDisplay="GRAPHIC_ONLY"
                accessibleText="Página anterior">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-left" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Página anterior"/></tooltip>
        </Button>
        <Label fx:id="lblPage" text="Página 1" styleClass="pagination-lbl"/>
        <Button fx:id="btnNext" onAction="#onNext" styleClass="pagination-btn" contentDisplay="GRAPHIC_ONLY"
                accessibleText="Página siguiente">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-right" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Página siguiente"/></tooltip>
        </Button>
        <ComboBox fx:id="pageSizeBox" prefWidth="82">
            <tooltip><Tooltip text="Bienes por página"/></tooltip>
        </ComboBox>
    </HBox>
</VBox>
