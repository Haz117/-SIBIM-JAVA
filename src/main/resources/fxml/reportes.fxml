<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sibim.controller.ReportesController"
            fitToWidth="true" styleClass="page-scroll">
<VBox spacing="20">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header, page-header-indigo">
        <StackPane styleClass="page-header-icon, page-header-icon-indigo">
            <FontIcon iconLiteral="mdi2f-file-chart-outline" styleClass="page-icon-symbol"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Reportes y Exportaciones" styleClass="page-title"/>
            <Label fx:id="lblSubtitulo" text="Listados y formatos oficiales en PDF, Excel y CSV" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
    </HBox>

    <!-- ══ SELECTOR DE PERÍODO ═══════════════════════════════════════ -->
    <VBox fx:id="periodCard" styleClass="card" spacing="12">
        <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="mdi2c-calendar-month" styleClass="card-icon-lg"/>
            <Label text="Período del reporte" styleClass="card-title"/>
            <Label fx:id="helpPeriodo" text="?" styleClass="help-badge">
                <tooltip><Tooltip text="Filtra por fecha de registro. Aplica a los reportes de Inventario y Movimientos y a las dos gráficas del final — los demás reportes incluyen siempre todo el historial." wrapText="true" maxWidth="290"/></tooltip>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAlcancePeriodo" text="Aplica a Inventario, Movimientos y las gráficas · vacío = todo el historial"
                   styleClass="report-hint"/>
        </HBox>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Desde:" styleClass="form-label"/>
                <DatePicker fx:id="desdeField" prefWidth="145" promptText="dd/mm/yyyy">
                    <tooltip><Tooltip text="Fecha de inicio del período"/></tooltip>
                </DatePicker>
            </HBox>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Hasta:" styleClass="form-label"/>
                <DatePicker fx:id="hastaField" prefWidth="145" promptText="dd/mm/yyyy">
                    <tooltip><Tooltip text="Fecha de fin del período"/></tooltip>
                </DatePicker>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnPresetHoy" text="Hoy"   onAction="#onReportHoy"    styleClass="btn-preset">
                <tooltip><Tooltip text="Solo el día de hoy"/></tooltip>
            </Button>
            <Button fx:id="btnPresetSemana" text="Semana" onAction="#onReportSemana" styleClass="btn-preset">
                <tooltip><Tooltip text="Últimos 7 días"/></tooltip>
            </Button>
            <Button fx:id="btnPresetMes" text="Mes"   onAction="#onReportMes"    styleClass="btn-preset">
                <tooltip><Tooltip text="Mes actual (del 1 al hoy)"/></tooltip>
            </Button>
            <Button fx:id="btnPresetAnio" text="Año"   onAction="#onReportAnio"   styleClass="btn-preset">
                <tooltip><Tooltip text="Año actual (del 1/enero al hoy)"/></tooltip>
            </Button>
            <Button fx:id="btnPresetTodo" text="Todo"  onAction="#onReportTodo"   styleClass="btn-preset">
                <tooltip><Tooltip text="Sin restricción de fecha"/></tooltip>
            </Button>
        </FlowPane>
    </VBox>

    <!-- ══ REPORTES ═══════════════════════════════════════════════════
         Las filas de cada lista se describen una sola vez en
         ReportesController#construirReportes y las dibuja ReporteFila.
         ══════════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="LISTADOS" styleClass="dash-section-label"/>
        <Label fx:id="helpTiposReporte" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="PDF: para imprimir o compartir tal cual. Excel: para seguir analizando o editando los datos. CSV: para importar a otro sistema. Solo los reportes que muestran la etiqueta de período se limitan a las fechas elegidas arriba; los demás incluyen siempre todo." wrapText="true" maxWidth="300"/></tooltip>
        </Label>
    </HBox>
    <VBox fx:id="listaListados" styleClass="report-list"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="FORMATOS OFICIALES" styleClass="dash-section-label"/>
    </HBox>
    <VBox fx:id="listaFormatos" styleClass="report-list"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="dash-section-bar"/>
        <Label text="GRÁFICAS DEL PERÍODO" styleClass="dash-section-label"/>
    </HBox>

    <!-- ══ GRÁFICA BIENES POR ÁREA ══════════════════════════════════════ -->
    <VBox styleClass="card" spacing="8">
        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="mdi2c-chart-bar" styleClass="card-icon-lg"/>
            <Label text="Distribución de bienes por área" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            <Label text="?" styleClass="help-badge">
                <tooltip><Tooltip text="Muestra hasta las 20 áreas con más bienes asignados, de mayor a menor, dentro del período seleccionado arriba. Un área sin ningún bien asignado en ese período simplemente no aparece — no es que falte, es que no tiene nada que mostrar." wrapText="true" maxWidth="300"/></tooltip>
            </Label>
            <ProgressIndicator fx:id="chartSpinner" prefWidth="18" prefHeight="18"
                               visible="false" managed="false"/>
        </HBox>
        <BarChart fx:id="areaChart" prefHeight="300" animated="false"
                  styleClass="area-bar-chart" legendVisible="false">
            <xAxis><NumberAxis label="Bienes" minorTickVisible="false"/></xAxis>
            <yAxis><CategoryAxis/></yAxis>
        </BarChart>
        <VBox fx:id="chartEmptyState" alignment="CENTER" spacing="10" prefHeight="180"
              visible="false" managed="false" styleClass="empty-state-pane">
            <FontIcon iconLiteral="mdi2c-chart-bar-stacked" iconSize="44" styleClass="empty-icon-lg"/>
            <Label text="Sin bienes en este período" styleClass="empty-state-msg"/>
            <Label text="Ningún bien con área asignada se registró entre las fechas elegidas" styleClass="empty-state-hint"/>
            <Button text="Ver todos los registros" onAction="#onReportTodo" styleClass="btn-secondary, btn-sm"
                    contentDisplay="LEFT" graphicTextGap="6">
                <graphic><FontIcon iconLiteral="mdi2c-calendar-remove-outline" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Quitar el filtro de fechas e incluir todos los registros  (Alt+5)"/></tooltip>
            </Button>
        </VBox>
    </VBox>

    <!-- ══ GRÁFICA VALOR POR CATEGORÍA ══════════════════════════════════ -->
    <VBox styleClass="card" spacing="8">
        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="mdi2c-chart-bar" styleClass="card-icon-lg"/>
            <Label text="Valor patrimonial por categoría" styleClass="card-title" HBox.hgrow="ALWAYS"/>
            <Label text="?" styleClass="help-badge">
                <tooltip><Tooltip text="Suma del valor de los bienes (precio × existencias) agrupados por categoría, dentro del período seleccionado arriba. Útil para ver en qué tipo de bienes está concentrado el patrimonio." wrapText="true" maxWidth="290"/></tooltip>
            </Label>
            <ProgressIndicator fx:id="categoriaChartSpinner" prefWidth="18" prefHeight="18"
                               visible="false" managed="false"/>
        </HBox>
        <BarChart fx:id="categoriaChart" prefHeight="300" animated="false"
                  styleClass="area-bar-chart" legendVisible="false">
            <xAxis><NumberAxis label="Valor ($)" minorTickVisible="false"/></xAxis>
            <yAxis><CategoryAxis/></yAxis>
        </BarChart>
        <VBox fx:id="categoriaChartEmptyState" alignment="CENTER" spacing="10" prefHeight="180"
              visible="false" managed="false" styleClass="empty-state-pane">
            <FontIcon iconLiteral="mdi2c-chart-bar-stacked" iconSize="44" styleClass="empty-icon-lg"/>
            <Label text="Sin valor patrimonial en este período" styleClass="empty-state-msg"/>
            <Label text="Ningún bien con categoría y precio se registró entre las fechas elegidas" styleClass="empty-state-hint"/>
            <Button text="Ver todos los registros" onAction="#onReportTodo" styleClass="btn-secondary, btn-sm"
                    contentDisplay="LEFT" graphicTextGap="6">
                <graphic><FontIcon iconLiteral="mdi2c-calendar-remove-outline" styleClass="btn-icon"/></graphic>
                <tooltip><Tooltip text="Quitar el filtro de fechas e incluir todos los registros  (Alt+5)"/></tooltip>
            </Button>
        </VBox>
    </VBox>

</VBox>
</ScrollPane>
