<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sibim.controller.ResguardosController"
      fx:id="rootPane" spacing="12">
    <padding><Insets top="20" right="22" bottom="20" left="34"/></padding>

    <!-- ══ PAGE HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="page-header page-header-indigo">
        <StackPane styleClass="page-header-icon page-header-icon-indigo">
            <FontIcon iconLiteral="mdi2b-badge-account-outline" styleClass="page-icon-emoji"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Resguardos de Bienes" styleClass="page-title"/>
            <Label text="Documentos oficiales de custodia patrimonial por servidor público" styleClass="page-subtitle"/>
        </VBox>
        <ProgressIndicator fx:id="spinner" prefWidth="22" prefHeight="22" visible="false" managed="false"/>
        <Button text="Actualizar" onAction="#onRefresh" styleClass="btn-ghost"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2r-refresh" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Actualizar lista de resguardos desde la base de datos"/></tooltip>
        </Button>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="btnToggleResumen" styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="6">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-up" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Muestra u oculta las tarjetas de resumen para dar más espacio a la tabla" wrapText="true" maxWidth="240"/></tooltip>
        </Button>
        <Label fx:id="helpResumen" text="?" styleClass="help-badge">
            <tooltip><Tooltip text="Oculta las tarjetas de resumen para darle más espacio a la tabla — se puede volver a mostrar con el mismo botón." wrapText="true" maxWidth="260"/></tooltip>
        </Label>
        <Button fx:id="btnNuevo" text="Nuevo Resguardo" onAction="#onNuevoResguardo" styleClass="btn-primary"
                contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2p-plus" styleClass="btn-icon"/></graphic>
        </Button>
    </HBox>

    <VBox fx:id="resumenBox" spacing="12">
    <!-- ══ STAT CARDS ══════════════════════════════════════════════ -->
    <HBox spacing="12">
        <VBox fx:id="statCardTotal" styleClass="rich-stat-card, rich-stat-indigo"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-indigo">
                    <FontIcon iconLiteral="mdi2b-badge-account-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="TOTAL RESGUARDOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatTotal" text="—" styleClass="rich-stat-value"/>
            <Label text="documentos registrados" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardActivos" styleClass="rich-stat-card, rich-stat-teal"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-teal">
                    <FontIcon iconLiteral="mdi2c-check-circle-outline" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="ACTIVOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatActivos" text="—" styleClass="rich-stat-value"/>
            <Label text="resguardos vigentes" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardCancelados" styleClass="rich-stat-card, rich-stat-amber"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-amber">
                    <FontIcon iconLiteral="mdi2c-cancel" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="CANCELADOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatCancelados" text="—" styleClass="rich-stat-value"/>
            <Label text="resguardos dados de baja" styleClass="rich-stat-hint"/>
        </VBox>
        <VBox fx:id="statCardBienes" styleClass="rich-stat-card, rich-stat-slate"
              HBox.hgrow="ALWAYS" spacing="5" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <StackPane styleClass="rich-stat-icon-badge, rich-stat-icon-badge-slate">
                    <FontIcon iconLiteral="mdi2p-package-variant-closed" styleClass="rich-stat-icon"/>
                </StackPane>
                <Label text="BIENES RESGUARDADOS" styleClass="rich-stat-label" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="lblStatBienes" text="—" styleClass="rich-stat-value"/>
            <Label text="ítems bajo custodia activa" styleClass="rich-stat-hint"/>
        </VBox>
    </HBox>
    </VBox>

    <!-- ══ TOOLBAR ═══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="filter-bar filter-bar-indigo">
        <TextField fx:id="searchField" promptText="Buscar por resguardante, área o número…"
                   styleClass="search-field" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportarPdf" text="Exportar PDF" onAction="#onExportarPdf"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" styleClass="btn-icon"/></graphic>
        </Button>
        <Button fx:id="btnCancelar" text="Dar de baja" onAction="#onCancelar"
                styleClass="btn-secondary" contentDisplay="LEFT" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="mdi2d-delete-circle-outline" styleClass="btn-icon"/></graphic>
            <tooltip><Tooltip text="Cancelar el resguardo seleccionado (Delete)"/></tooltip>
        </Button>
    </HBox>

    <!-- ══ TABLE ══════════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colNumero"       text="Folio"        prefWidth="110"/>
            <TableColumn fx:id="colResguardante" text="Resguardante" prefWidth="190" maxWidth="260"/>
            <TableColumn fx:id="colArea"         text="Área"         prefWidth="200" maxWidth="260"/>
            <TableColumn fx:id="colFecha"        text="Fecha"        prefWidth="95"/>
            <TableColumn fx:id="colBienes"       text="Bienes"       prefWidth="65"/>
            <TableColumn fx:id="colEstado"       text="Estado"       prefWidth="90"/>
        </columns>
        <placeholder>
            <Label text="No hay resguardos registrados. Crea el primero con &quot;Nuevo Resguardo&quot;."
                   styleClass="table-placeholder"/>
        </placeholder>
    </TableView>
</VBox>
